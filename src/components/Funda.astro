---
// src/components/Funda.astro
//
// Una funda del archivo musical: la carátula y el vinilo que asoma de ella.
// El script de la página lee los data-* para saber qué poner al soltarlo.
import type { Disco } from '../data/portfolio';

interface Props {
    disco: Disco;
    /** Estante en el que va: el vinilo asoma hacia el plato */
    lado: 'izq' | 'der';
    /** Lado de la funda en px, para que el disco salga entero al sacarlo */
    tam: number;
}

const { disco, lado, tam } = Astro.props;
const hacia = lado === 'izq' ? 1 : -1;

// --- Balón (forma: 'balon') ---
// Pentágono central, cinco alrededor cortados por el borde y las costuras
// que cierran los hexágonos. Las medidas están ajustadas para que las
// costuras salgan de longitud parecida y se lea como un balón.
const esBalon = disco.forma === 'balon';
const rad = (g: number) => (g * Math.PI) / 180;
const pentagono = (cx: number, cy: number, r: number, giro: number) =>
    [0, 1, 2, 3, 4].map((i): [number, number] => [cx + r * Math.cos(rad(giro + 72 * i)), cy + r * Math.sin(rad(giro + 72 * i))]);
const puntos = (p: [number, number][]) => p.map(([x, y]) => `${x.toFixed(2)},${y.toFixed(2)}`).join(' ');

const R_CENTRO = 12, DIST = 36, R_EXT = 14;
const direcciones = [0, 1, 2, 3, 4].map((k) => -90 + 72 * k);
const pentCentro = pentagono(50, 50, R_CENTRO, -90);
// Los exteriores miran con un vértice hacia el centro: ese vértice es el final de la costura radial
const pentExt = direcciones.map((d) => pentagono(50 + DIST * Math.cos(rad(d)), 50 + DIST * Math.sin(rad(d)), R_EXT, d + 180));
const costuras = direcciones.flatMap((d, k) => [
    [pentCentro[k], pentExt[k][0]],
    // vértice 4 del pentágono k y vértice 1 del siguiente: se miran entre sí
    [pentExt[k][4], pentExt[(k + 1) % 5][1]],
]);
const colores = disco.pentagonos?.length ? disco.pentagonos : ['#1a1a1a'];
const idClip = `balon-${disco.id}`;
const estiloPortada = [`background-image: url('${disco.portada}')`, disco.fondo && `background-color: ${disco.fondo}`]
    .filter(Boolean)
    .join('; ');
---

<div
    class="sleeve-container"
    data-peek={35 * hacia}
    data-slide={tam * hacia}
    data-titulo={disco.titulo}
    data-detalle={disco.detalle}
    data-portada={disco.portada}
    data-medio={disco.medio ? JSON.stringify(disco.medio) : undefined}
>
    <div class:list={['vinyl-wrapper', { 'es-balon': esBalon }]}>
        {esBalon ? (
            <>
                <svg viewBox="0 0 100 100" class="vinyl-art" aria-hidden="true">
                    <defs>
                        <clipPath id={idClip}><circle cx="50" cy="50" r="47" /></clipPath>
                    </defs>
                    <circle cx="50" cy="50" r="47" fill="#f7f6f2" />
                    <g clip-path={`url(#${idClip})`}>
                        <polygon points={puntos(pentCentro)} fill={colores[0]} />
                        {pentExt.map((p, k) => <polygon points={puntos(p)} fill={colores[(k + 1) % colores.length]} />)}
                        {costuras.map(([a, b]) => (
                            <line x1={a[0].toFixed(2)} y1={a[1].toFixed(2)} x2={b[0].toFixed(2)} y2={b[1].toFixed(2)} stroke="#3a3a3a" stroke-width="1.4" stroke-linecap="round" />
                        ))}
                    </g>
                    <circle cx="50" cy="50" r="47" fill="none" stroke="#1a1a1a" stroke-width="2" />
                </svg>
                <!-- Luz fija encima: no gira con el balón, así parece que rueda -->
                <span class="balon-brillo" aria-hidden="true"></span>
            </>
        ) : (
            <svg viewBox="0 0 100 100" class="vinyl-art" aria-hidden="true">
                <circle cx="50" cy="50" r="48" fill="#0b1714" stroke="#223b33" stroke-width="0.5" />
                <circle cx="50" cy="50" r="38" stroke="#1a2e28" stroke-width="1" fill="none" />
                <circle cx="50" cy="50" r="28" stroke="#1a2e28" stroke-width="1" fill="none" />
                <circle cx="50" cy="50" r="16" fill={disco.galleta} />
                <circle cx="50" cy="50" r="2" fill="#F4F1EC" />
            </svg>
        )}
    </div>
    <div
        class:list={['album-cover', { 'es-logo': disco.portadaEsLogo }]}
        style={estiloPortada}
        role="img"
        aria-label={`${disco.titulo}. ${disco.detalle}`}
    >
        <span class="cover-label">{disco.etiqueta}</span>
    </div>
</div>

<style>
    .sleeve-container {
        position: relative;
        width: var(--disco, 160px);
        height: var(--disco, 160px);
    }

    .album-cover {
        position: absolute;
        inset: 0;
        z-index: 20;
        overflow: hidden;
        border-radius: 4px;
        background-color: #1b2a25;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6);
        border: 1px solid rgba(244, 241, 236, 0.1);
        cursor: pointer;
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.2), box-shadow 0.4s ease;
    }
    /* Los logos no se recortan: van centrados sobre su color */
    .album-cover.es-logo {
        background-size: 72% auto;
        background-position: center 42%;
    }

    .sleeve-container:hover .album-cover {
        transform: scale(1.05);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.8);
    }

    /* Tira con el nombre al pie de la carátula, sin tapar la imagen */
    .cover-label {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        padding: 6px 8px;
        background: rgba(17, 35, 30, 0.82);
        color: #f4f1ec;
        font-size: 0.55rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        line-height: 1.3;
        text-align: center;
        pointer-events: none;
    }

    .vinyl-wrapper {
        position: absolute;
        top: 2px;
        left: 2px;
        width: calc(var(--disco, 160px) - 4px);
        height: calc(var(--disco, 160px) - 4px);
        z-index: 10;
        touch-action: none;
        cursor: grab;
    }
    .vinyl-wrapper.dragging {
        cursor: grabbing;
        z-index: 60 !important;
    }
    .vinyl-art {
        width: 100%;
        height: 100%;
        filter: drop-shadow(0 10px 15px rgba(0, 0, 0, 0.5));
    }

    /* Balón: volumen con una luz fija arriba a la izquierda y el borde en sombra */
    .balon-brillo {
        position: absolute;
        inset: 1%;
        border-radius: 50%;
        pointer-events: none;
        background:
            radial-gradient(circle at 34% 28%, rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0) 30%),
            radial-gradient(circle at 50% 50%, transparent 55%, rgba(0, 0, 0, 0.3) 100%);
    }

    @keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    .vinyl-wrapper.playing .vinyl-art {
        animation: spin 3s linear infinite;
    }

    /* En móvil la escena entera se encoge: el rótulo necesita más cuerpo */
    @media (max-width: 560px) {
        .cover-label {
            font-size: 1.05rem;
            letter-spacing: 0.08em;
            padding: 8px 6px;
        }
    }
</style>
