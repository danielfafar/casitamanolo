---
// src/components/Idiomas.astro
//
// El selector de idioma: un chip por idioma, con la misma pinta que los
// rótulos de la casa (fondo crema, filo verde oscuro, letra de máquina de
// escribir). El del idioma que se está leyendo va en rojo, como cuando
// señalas un sitio en el home; los otros son enlaces a la misma página.
//
// Sin JavaScript: son enlaces, se ven todos y no se despliega nada.
import { idiomas, enlace, type Idioma } from '../i18n/config';
import { banderas } from '../i18n/banderas';
import { textos } from '../i18n/textos';

interface Props {
    /** Idioma que se está pintando */
    idioma: Idioma;
    /** Página actual sin prefijo de idioma: '/', '/portfolio'… */
    destino: string;
}

const { idioma, destino } = Astro.props;
const T = textos[idioma];
---

<nav class="idiomas" aria-label={T.comun.idioma}>
    {idiomas.map((cual) => {
        const puesto = cual === idioma;
        const b = banderas[cual];
        return (
            <a
                class:list={['idioma', { 'idioma--puesto': puesto }]}
                href={enlace(destino, cual)}
                lang={cual}
                hreflang={cual}
                aria-current={puesto ? 'true' : undefined}
                aria-label={puesto ? `${T.comun.idioma}: ${b.nombre}` : `${T.comun.cambiarA} ${b.nombre}`}
            >
                <svg class="bandera" viewBox="0 0 20 14" aria-hidden="true">
                    <defs>
                        <clipPath id={`recorte-${cual}`}>
                            <rect x="0.7" y="0.7" width="18.6" height="12.6" rx="2.2" />
                        </clipPath>
                    </defs>

                    <g clip-path={`url(#recorte-${cual})`}>
                        {b.pais === 'es' && (
                            <>
                                <rect width="20" height="14" fill="#E8B059" />
                                <rect width="20" height="3.8" fill="#C8443A" />
                                <rect y="10.2" width="20" height="3.8" fill="#C8443A" />
                            </>
                        )}

                        {b.pais === 'us' && (
                            <>
                                <rect width="20" height="14" fill="#F4F1EC" />
                                <rect y="0" width="20" height="2" fill="#C8443A" />
                                <rect y="4" width="20" height="2" fill="#C8443A" />
                                <rect y="8" width="20" height="2" fill="#C8443A" />
                                <rect y="12" width="20" height="2" fill="#C8443A" />
                                <rect width="9.4" height="6" fill="#2A5A84" />
                                <circle cx="2.6" cy="1.8" r="0.62" fill="#F4F1EC" />
                                <circle cx="6.6" cy="1.8" r="0.62" fill="#F4F1EC" />
                                <circle cx="4.6" cy="3" r="0.62" fill="#F4F1EC" />
                                <circle cx="2.6" cy="4.2" r="0.62" fill="#F4F1EC" />
                                <circle cx="6.6" cy="4.2" r="0.62" fill="#F4F1EC" />
                            </>
                        )}

                        {b.pais === 'cn' && (
                            <>
                                <rect width="20" height="14" fill="#C8443A" />
                                <path d="M4.6 2.4 l0.85 1.75 1.9 0.28 -1.38 1.35 0.33 1.9 -1.7-0.9 -1.7 0.9 0.33-1.9 -1.38-1.35 1.9-0.28z" fill="#E8B059" />
                                <circle cx="8.6" cy="1.9" r="0.62" fill="#E8B059" />
                                <circle cx="10" cy="3.5" r="0.62" fill="#E8B059" />
                                <circle cx="10" cy="5.6" r="0.62" fill="#E8B059" />
                                <circle cx="8.6" cy="7.2" r="0.62" fill="#E8B059" />
                            </>
                        )}
                    </g>

                    <rect x="0.7" y="0.7" width="18.6" height="12.6" rx="2.2" fill="none" stroke="currentColor" stroke-width="1.4" />
                </svg>

                <span class="codigo">{b.codigo}</span>
            </a>
        );
    })}
</nav>

<style>
    /* En el ordenador, arriba en el centro. Abajo a la derecha es donde
       Netlify pone su distintivo y se peleaban. */
    .idiomas {
        position: fixed;
        top: 14px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 200;
        display: flex;
        gap: 7px;
    }

    /* La misma chapa que los rótulos de la casa */
    .idioma {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 5px 11px 5px 7px;
        border: 1.5px solid #11231E;
        border-radius: 999px;
        background: #F4F1EC;
        color: #11231E;
        text-decoration: none;
        font-family: 'Space Mono', monospace;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.12em;
        line-height: 1;
        opacity: 0.72;
        transition: background-color 0.3s, border-color 0.3s, color 0.3s, opacity 0.3s, transform 0.3s;
    }

    .bandera { display: block; width: 20px; height: 14px; flex: none; }
    .codigo { display: block; }

    /* El idioma que estás leyendo: en rojo, como el rótulo señalado del home */
    .idioma--puesto {
        background: #D74F42;
        border-color: #D74F42;
        color: #F4F1EC;
        opacity: 1;
        cursor: default;
    }

    .idioma:hover,
    .idioma:focus-visible {
        opacity: 1;
        transform: translateY(2px);
    }
    .idioma:not(.idioma--puesto):hover,
    .idioma:not(.idioma--puesto):focus-visible {
        background: #11231E;
        border-color: #11231E;
        color: #F4F1EC;
    }

    .idioma:focus-visible { outline: 3px solid #E8B059; outline-offset: 3px; }

    /* En el móvil arriba están el volver y el indicador de la mesa, así que
       bajan a la esquina de la izquierda: lejos de las flechas y del
       distintivo de Netlify, que va a la derecha.

       Y solo se ve la chapa del idioma al que puedes cambiar: el que estás
       leyendo ya lo dice la propia página, así que gastar con él una esquina
       encima del contenido no compensa en una pantalla pequeña. */
    @media (max-width: 680px) {
        .idiomas {
            top: auto;
            bottom: 12px;
            left: 10px;
            transform: none;
            flex-direction: column;
            align-items: flex-start;
            gap: 6px;
        }
        .idioma--puesto { display: none; }
        .idioma { padding: 6px 10px 6px 6px; font-size: 11px; opacity: 0.85; }
        .bandera { width: 18px; height: 12.6px; }
    }

    @media (prefers-reduced-motion: reduce) {
        .idioma { transition: none; }
    }
</style>
