---
import Layout from '../layouts/Layout.astro';
import '../styles/listening.css';
interface Props { title: string; current: 'radio' | 'television'; }
const { title, current } = Astro.props;
---
<Layout title={title}>
  <div class="listening-room">
    <header class="room-header">
      <a class="home-link" href="/">← Volver a casa</a>
      <nav aria-label="Rincones musicales">
        <a href="/radio" aria-current={current === 'radio' ? 'page' : undefined}>Radio</a>
        <a href="/television" aria-current={current === 'television' ? 'page' : undefined}>Televisión</a>
        <a href="/clientes">Posavasos</a>
      </nav>
    </header>
    <main class="room-content"><slot /></main>
    <footer class="room-footer">
      <span>Casita Manolo · Music House Madrid</span>
      <a href="/contacto">Cuéntanos tu proyecto</a>
    </footer>
  </div>
</Layout>
