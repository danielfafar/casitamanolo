---
// src/components/RadioTV.astro
//
// Televisor viejo con dial de emisoras. Cada posición del dial es un estilo
// musical y suena de verdad: el dial cambia el src del <audio>.
//
// Las pistas van en /public/audio con el nombre de cada emisora. Mientras no
// estén, la tele lo dice en pantalla ("SIN SEÑAL") en vez de quedarse muda sin
// explicar por qué.

const emisoras = [
    { id: 'orquesta',    nombre: 'ORQUESTA',    dial: '88.2' },
    { id: 'electronica', nombre: 'ELECTRÓNICA', dial: '91.7' },
    { id: 'jazz',        nombre: 'JAZZ',        dial: '95.4' },
    { id: 'folk',        nombre: 'FOLK',        dial: '99.1' },
    { id: 'rock',        nombre: 'ROCK',        dial: '102.6' },
    { id: 'ambient',     nombre: 'AMBIENT',     dial: '106.3' },
];

// El dial recorre 240º repartidos entre todas las emisoras
const ARCO = 240;
const paso = ARCO / (emisoras.length - 1);
---

<!-- Botón de encendido, arriba a la derecha -->
<button class="tv-trigger" id="tv-trigger" aria-expanded="false" aria-controls="tv-panel">
    <svg viewBox="0 0 24 20" aria-hidden="true">
        <rect x="1.5" y="5.5" width="21" height="13" rx="2" />
        <path d="M7 1.5 L12 5.5 L17 1.5" />
    </svg>
    <span>RADIO</span>
</button>

<!-- Panel del televisor -->
<div class="tv-backdrop" id="tv-backdrop"></div>

<section class="tv-panel" id="tv-panel" role="dialog" aria-modal="true" aria-label="Radio de la casa" hidden>

    <div class="tv-set">
        <!-- Pantalla -->
        <div class="tv-screen-frame">
            <div class="tv-screen" id="tv-screen">
                <div class="tv-static"></div>
                <div class="tv-content">
                    <p class="tv-station" id="tv-station">ORQUESTA</p>
                    <p class="tv-freq" id="tv-freq">88.2 MHz</p>
                    <div class="tv-eq" id="tv-eq" aria-hidden="true">
                        <span></span><span></span><span></span><span></span><span></span>
                    </div>
                    <p class="tv-status" id="tv-status">APAGADA</p>
                </div>
                <div class="tv-scanlines" aria-hidden="true"></div>
            </div>
        </div>

        <!-- Consola inferior: dial + mando -->
        <div class="tv-console">
            <div class="tv-dial-zone">
                <div class="tv-dial">
                    <div class="tv-ticks" aria-hidden="true">
                        {emisoras.map((e, i) => (
                            <span class="tv-tick" style={`--angle:${-ARCO / 2 + i * paso}deg`}></span>
                        ))}
                    </div>
                    <div
                        class="tv-knob"
                        id="tv-knob"
                        role="slider"
                        tabindex="0"
                        aria-label="Dial de emisoras"
                        aria-valuemin="1"
                        aria-valuemax={emisoras.length}
                        aria-valuenow="1"
                        aria-valuetext="Orquesta"
                    >
                        <span class="tv-knob-mark"></span>
                    </div>
                </div>
                <p class="tv-hint">Gira el dial</p>
            </div>

            <div class="tv-buttons">
                <button class="tv-power" id="tv-power" aria-pressed="false">
                    <span class="tv-led" aria-hidden="true"></span>
                    <span id="tv-power-label">ENCENDER</span>
                </button>
                <ul class="tv-presets" id="tv-presets">
                    {emisoras.map((e, i) => (
                        <li>
                            <button class="tv-preset" data-index={i} aria-pressed={i === 0 ? 'true' : 'false'}>
                                {e.nombre}
                            </button>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </div>

    <button class="tv-close" id="tv-close" aria-label="Cerrar la radio">✕ <span class="tv-kbd">ESC</span></button>

    <audio id="tv-audio" loop preload="none"></audio>
</section>

<script define:vars={{ emisoras, ARCO, paso }}>
    document.addEventListener('astro:page-load', () => {
        const trigger = document.getElementById('tv-trigger');
        const panel = document.getElementById('tv-panel');
        const backdrop = document.getElementById('tv-backdrop');
        const closeBtn = document.getElementById('tv-close');
        const knob = document.getElementById('tv-knob');
        const dial = knob?.parentElement;
        const audio = document.getElementById('tv-audio');
        const powerBtn = document.getElementById('tv-power');
        const powerLabel = document.getElementById('tv-power-label');
        const screen = document.getElementById('tv-screen');
        const nombreEl = document.getElementById('tv-station');
        const freqEl = document.getElementById('tv-freq');
        const statusEl = document.getElementById('tv-status');
        const presets = [...document.querySelectorAll('.tv-preset')];

        if (!trigger || !panel || !knob || !audio) return;

        let indice = 0;
        let encendida = false;

        /* ----------------------------------------------------------
           Sintonizar: mueve el dial y carga la pista de esa emisora
           ---------------------------------------------------------- */
        const anguloDe = (i) => -ARCO / 2 + i * paso;

        function pintarEmisora() {
            const e = emisoras[indice];
            knob.style.transform = `rotate(${anguloDe(indice)}deg)`;
            knob.setAttribute('aria-valuenow', String(indice + 1));
            knob.setAttribute('aria-valuetext', e.nombre);
            nombreEl.textContent = e.nombre;
            freqEl.textContent = `${e.dial} MHz`;
            presets.forEach((b, i) =>
                b.setAttribute('aria-pressed', i === indice ? 'true' : 'false')
            );
        }

        function estado(texto, clase) {
            statusEl.textContent = texto;
            screen.classList.remove('is-playing', 'is-nosignal', 'is-loading');
            if (clase) screen.classList.add(clase);
        }

        function sintonizar(nuevo, reproducir = true) {
            indice = (nuevo + emisoras.length) % emisoras.length;
            pintarEmisora();

            if (!encendida) {
                estado('APAGADA', null);
                return;
            }

            audio.src = `/audio/${emisoras[indice].id}.mp3`;
            estado('SINTONIZANDO', 'is-loading');

            if (!reproducir) return;
            audio.play().catch(() => {
                // Puede fallar por autoplay o porque el archivo no existe;
                // el listener de 'error' ya cuenta el segundo caso.
            });
        }

        audio.addEventListener('playing', () => estado('EN ANTENA', 'is-playing'));
        audio.addEventListener('waiting', () => estado('SINTONIZANDO', 'is-loading'));
        audio.addEventListener('error', () => {
            if (encendida) estado('SIN SEÑAL · PISTA PENDIENTE', 'is-nosignal');
        });

        /* ----------------------------------------------------------
           Encendido
           ---------------------------------------------------------- */
        function alternarEncendido() {
            encendida = !encendida;
            powerBtn.setAttribute('aria-pressed', String(encendida));
            powerLabel.textContent = encendida ? 'APAGAR' : 'ENCENDER';
            panel.classList.toggle('tv-on', encendida);

            if (encendida) {
                sintonizar(indice);
            } else {
                audio.pause();
                estado('APAGADA', null);
            }
        }

        powerBtn?.addEventListener('click', alternarEncendido);

        /* ----------------------------------------------------------
           Girar el dial: arrastre, teclado y presets
           ---------------------------------------------------------- */
        let arrastrando = false;

        function indiceDesdeAngulo(ev) {
            const r = dial.getBoundingClientRect();
            const cx = r.left + r.width / 2;
            const cy = r.top + r.height / 2;
            // 0º = arriba, positivo en sentido horario
            let ang = (Math.atan2(ev.clientX - cx, cy - ev.clientY) * 180) / Math.PI;
            ang = Math.max(-ARCO / 2, Math.min(ARCO / 2, ang));
            return Math.round((ang + ARCO / 2) / paso);
        }

        knob.addEventListener('pointerdown', (ev) => {
            arrastrando = true;
            knob.setPointerCapture(ev.pointerId);
            knob.classList.add('is-grabbing');
        });

        knob.addEventListener('pointermove', (ev) => {
            if (!arrastrando) return;
            const nuevo = indiceDesdeAngulo(ev);
            if (nuevo !== indice) sintonizar(nuevo);
        });

        const soltar = (ev) => {
            if (!arrastrando) return;
            arrastrando = false;
            knob.classList.remove('is-grabbing');
            if (ev.pointerId !== undefined && knob.hasPointerCapture?.(ev.pointerId)) {
                knob.releasePointerCapture(ev.pointerId);
            }
        };
        knob.addEventListener('pointerup', soltar);
        knob.addEventListener('pointercancel', soltar);

        knob.addEventListener('keydown', (ev) => {
            if (ev.key === 'ArrowRight' || ev.key === 'ArrowUp') {
                ev.preventDefault();
                sintonizar(indice + 1);
            } else if (ev.key === 'ArrowLeft' || ev.key === 'ArrowDown') {
                ev.preventDefault();
                sintonizar(indice - 1);
            } else if (ev.key === 'Home') {
                ev.preventDefault();
                sintonizar(0);
            } else if (ev.key === 'End') {
                ev.preventDefault();
                sintonizar(emisoras.length - 1);
            }
        });

        presets.forEach((b) =>
            b.addEventListener('click', () => sintonizar(Number(b.dataset.index)))
        );

        /* ----------------------------------------------------------
           Abrir y cerrar el panel
           ---------------------------------------------------------- */
        function abrir() {
            panel.hidden = false;
            // Forzamos el calculo de estilo para que la transicion arranque
            // desde el estado cerrado. Con requestAnimationFrame el panel se
            // quedaba a medias si la pestana no estaba visible, porque el
            // navegador no ejecuta esos callbacks en segundo plano.
            void panel.offsetHeight;
            panel.classList.add('is-open');
            backdrop?.classList.add('is-open');
            trigger.setAttribute('aria-expanded', 'true');
            document.body.classList.add('tv-abierta');
            powerBtn?.focus();
        }

        function cerrar() {
            panel.classList.remove('is-open');
            backdrop?.classList.remove('is-open');
            trigger.setAttribute('aria-expanded', 'false');
            document.body.classList.remove('tv-abierta');
            trigger.focus();
            // la música sigue sonando aunque cierres el panel
            setTimeout(() => {
                if (!panel.classList.contains('is-open')) panel.hidden = true;
            }, 400);
        }

        trigger.addEventListener('click', () => {
            panel.classList.contains('is-open') ? cerrar() : abrir();
        });
        closeBtn?.addEventListener('click', cerrar);
        backdrop?.addEventListener('click', cerrar);
        document.addEventListener('keydown', (ev) => {
            if (ev.key === 'Escape' && panel.classList.contains('is-open')) cerrar();
        });

        // Si navegas a otra página, la radio se calla
        document.addEventListener('astro:before-swap', () => audio.pause(), { once: true });

        pintarEmisora();
        estado('APAGADA', null);
    });
</script>

<style>
    /* ========================================================
       BOTÓN DE ARRIBA
       ======================================================== */
    .tv-trigger {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 60;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 16px;
        border-radius: 30px;
        border: 1px solid rgba(17, 35, 30, 0.25);
        background: rgba(244, 241, 236, 0.75);
        backdrop-filter: blur(6px);
        color: var(--ink-color, #11231E);
        font-family: 'Space Mono', monospace;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        cursor: pointer;
        transition: transform 0.25s var(--ease-spring, ease), background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    }
    .tv-trigger svg {
        width: 17px;
        height: auto;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .tv-trigger:hover,
    .tv-trigger:focus-visible {
        background: var(--accent-color, #D74F42);
        border-color: var(--accent-color, #D74F42);
        color: #F4F1EC;
        transform: scale(1.04);
    }
    .tv-trigger:active { transform: scale(0.96); }

    /* El botón late despacio mientras la radio suena */
    .tv-trigger[aria-expanded='true'] { background: var(--ink-color, #11231E); border-color: var(--ink-color, #11231E); color: #F4F1EC; }

    /* ========================================================
       PANEL
       ======================================================== */
    .tv-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(11, 23, 20, 0.82);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.4s var(--ease-out, ease);
        z-index: 70;
    }
    .tv-backdrop.is-open { opacity: 1; pointer-events: auto; }

    .tv-panel {
        position: fixed;
        top: 50%;
        left: 50%;
        z-index: 80;
        transform: translate(-50%, -50%) scale(0.88);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.35s var(--ease-out, ease), transform 0.45s var(--ease-spring, ease);
    }
    .tv-panel[hidden] { display: none; }
    .tv-panel.is-open { opacity: 1; transform: translate(-50%, -50%) scale(1); pointer-events: auto; }

    /* ========================================================
       EL MUEBLE
       ======================================================== */
    .tv-set {
        width: min(440px, 90vw);
        padding: 22px 22px 18px;
        border-radius: 18px;
        background: linear-gradient(165deg, #6b4227 0%, #4a2c18 55%, #35200f 100%);
        box-shadow: 0 30px 70px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.14);
        font-family: 'Space Mono', monospace;
    }

    .tv-screen-frame {
        padding: 12px;
        border-radius: 14px;
        background: #1c1109;
        box-shadow: inset 0 3px 10px rgba(0, 0, 0, 0.8);
    }

    .tv-screen {
        position: relative;
        aspect-ratio: 4 / 3;
        border-radius: 10px / 14px;
        overflow: hidden;
        background: radial-gradient(ellipse at 50% 45%, #14302a 0%, #08150f 75%);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: #8ee4b8;
    }

    .tv-content { position: relative; z-index: 2; padding: 0 12px; }

    .tv-station {
        margin: 0;
        font-size: clamp(1.1rem, 5vw, 1.7rem);
        font-weight: 700;
        letter-spacing: 0.16em;
        opacity: 0.25;
        transition: opacity 0.3s ease, text-shadow 0.3s ease;
    }
    .tv-freq {
        margin: 4px 0 0;
        font-size: 0.65rem;
        letter-spacing: 0.3em;
        opacity: 0.15;
        transition: opacity 0.3s ease;
    }
    .tv-status {
        margin: 12px 0 0;
        font-size: 0.55rem;
        letter-spacing: 0.25em;
        opacity: 0.5;
    }

    /* Con la tele encendida la pantalla se ilumina */
    .tv-screen.is-playing .tv-station,
    .tv-screen.is-loading .tv-station,
    .tv-screen.is-nosignal .tv-station { opacity: 1; text-shadow: 0 0 14px rgba(142, 228, 184, 0.55); }
    .tv-screen.is-playing .tv-freq,
    .tv-screen.is-loading .tv-freq,
    .tv-screen.is-nosignal .tv-freq { opacity: 0.6; }
    .tv-screen.is-nosignal { color: #e8b059; }

    /* Ecualizador: solo se mueve cuando suena de verdad */
    .tv-eq {
        display: flex;
        justify-content: center;
        align-items: flex-end;
        gap: 4px;
        height: 22px;
        margin-top: 10px;
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    .tv-eq span {
        width: 4px;
        height: 4px;
        border-radius: 1px;
        background: currentColor;
    }
    .tv-screen.is-playing .tv-eq { opacity: 0.9; }
    .tv-screen.is-playing .tv-eq span { animation: eq 0.9s ease-in-out infinite alternate; }
    .tv-screen.is-playing .tv-eq span:nth-child(2) { animation-delay: -0.2s; }
    .tv-screen.is-playing .tv-eq span:nth-child(3) { animation-delay: -0.5s; }
    .tv-screen.is-playing .tv-eq span:nth-child(4) { animation-delay: -0.3s; }
    .tv-screen.is-playing .tv-eq span:nth-child(5) { animation-delay: -0.7s; }
    @keyframes eq { from { height: 4px; } to { height: 20px; } }

    /* Nieve: solo cuando no hay pista */
    .tv-static {
        position: absolute;
        inset: 0;
        z-index: 1;
        opacity: 0;
        transition: opacity 0.3s ease;
        background-image: repeating-linear-gradient(
            0deg,
            rgba(255, 255, 255, 0.07) 0px,
            rgba(255, 255, 255, 0.07) 1px,
            transparent 1px,
            transparent 3px
        );
    }
    .tv-screen.is-nosignal .tv-static { opacity: 1; animation: nieve 0.35s steps(2) infinite; }
    @keyframes nieve { to { transform: translateY(3px); } }

    .tv-scanlines {
        position: absolute;
        inset: 0;
        z-index: 3;
        pointer-events: none;
        background-image: repeating-linear-gradient(
            0deg,
            rgba(0, 0, 0, 0.22) 0px,
            rgba(0, 0, 0, 0.22) 1px,
            transparent 1px,
            transparent 3px
        );
    }

    /* ========================================================
       CONSOLA: DIAL Y BOTONES
       ======================================================== */
    .tv-console {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-top: 16px;
    }

    .tv-dial-zone { flex-shrink: 0; text-align: center; }

    .tv-dial {
        position: relative;
        width: 96px;
        height: 96px;
        border-radius: 50%;
        background: radial-gradient(circle at 38% 32%, #4b4b4b, #1d1d1d 70%);
        box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.7), 0 3px 8px rgba(0, 0, 0, 0.45);
        display: grid;
        place-items: center;
    }

    .tv-ticks { position: absolute; inset: 0; }
    .tv-tick {
        position: absolute;
        top: 5px;
        left: 50%;
        width: 2px;
        height: 7px;
        border-radius: 1px;
        background: rgba(232, 176, 89, 0.65);
        transform-origin: 50% 43px;
        transform: translateX(-50%) rotate(var(--angle));
    }

    .tv-knob {
        position: relative;
        width: 62px;
        height: 62px;
        border-radius: 50%;
        background: linear-gradient(150deg, #e9e4d8, #b9b1a0);
        box-shadow: 0 3px 7px rgba(0, 0, 0, 0.5), inset 0 -2px 5px rgba(0, 0, 0, 0.25);
        cursor: grab;
        touch-action: none;
        transition: transform 0.35s var(--ease-spring, ease);
        outline: none;
    }
    .tv-knob.is-grabbing { cursor: grabbing; transition: none; }
    .tv-knob:focus-visible { box-shadow: 0 0 0 3px #D74F42, 0 3px 7px rgba(0, 0, 0, 0.5); }

    .tv-knob-mark {
        position: absolute;
        top: 7px;
        left: 50%;
        transform: translateX(-50%);
        width: 3px;
        height: 16px;
        border-radius: 2px;
        background: #D74F42;
    }

    .tv-hint {
        margin: 8px 0 0;
        font-size: 0.5rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(244, 241, 236, 0.45);
    }

    .tv-buttons { flex: 1; min-width: 0; }

    .tv-power {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        justify-content: center;
        padding: 9px 12px;
        border-radius: 6px;
        border: 1px solid rgba(244, 241, 236, 0.2);
        background: rgba(0, 0, 0, 0.3);
        color: #F4F1EC;
        font-family: inherit;
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        cursor: pointer;
        transition: background 0.25s ease, border-color 0.25s ease;
    }
    .tv-power:hover { background: rgba(0, 0, 0, 0.5); border-color: rgba(244, 241, 236, 0.4); }

    .tv-led {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #3a2a1c;
        transition: background 0.3s ease, box-shadow 0.3s ease;
    }
    .tv-power[aria-pressed='true'] .tv-led { background: #D74F42; box-shadow: 0 0 8px #D74F42; }

    .tv-presets {
        list-style: none;
        margin: 10px 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 5px;
    }
    .tv-preset {
        width: 100%;
        padding: 7px 2px;
        border-radius: 4px;
        border: 1px solid rgba(244, 241, 236, 0.14);
        background: rgba(0, 0, 0, 0.22);
        color: rgba(244, 241, 236, 0.6);
        font-family: inherit;
        font-size: 0.45rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }
    .tv-preset:hover { color: #F4F1EC; border-color: rgba(244, 241, 236, 0.4); }
    .tv-preset[aria-pressed='true'] {
        background: #D74F42;
        border-color: #D74F42;
        color: #F4F1EC;
    }

    /* ========================================================
       CERRAR
       ======================================================== */
    .tv-close {
        position: absolute;
        top: -46px;
        right: 0;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 14px;
        border-radius: 30px;
        border: 1px solid rgba(244, 241, 236, 0.3);
        background: rgba(17, 35, 30, 0.6);
        color: #F4F1EC;
        font-family: 'Space Mono', monospace;
        font-size: 0.7rem;
        cursor: pointer;
        transition: background 0.25s ease, color 0.25s ease;
    }
    .tv-close:hover { background: #F4F1EC; color: #11231E; }
    .tv-kbd { font-size: 0.55rem; border: 1px solid currentColor; border-radius: 3px; padding: 1px 4px; opacity: 0.7; }

    /* ========================================================
       MÓVIL
       ======================================================== */
    @media (max-width: 560px) {
        /* Todo lo que se toca pasa de 44px de alto */
        .tv-trigger { top: 14px; right: 14px; padding: 13px 16px; }
        .tv-set { padding: 16px 16px 14px; }
        .tv-console { flex-direction: column; gap: 14px; }
        .tv-dial { width: 118px; height: 118px; }
        .tv-tick { transform-origin: 50% 54px; }
        .tv-knob { width: 76px; height: 76px; }
        .tv-buttons { width: 100%; }
        .tv-power { padding: 14px 12px; font-size: 0.65rem; }
        .tv-preset { padding: 15px 2px; font-size: 0.52rem; }
        .tv-close { top: -52px; padding: 12px 16px; min-height: 44px; }
    }

    @media (prefers-reduced-motion: reduce) {
        .tv-screen.is-playing .tv-eq span,
        .tv-screen.is-nosignal .tv-static { animation: none; }
        .tv-knob { transition-duration: 0.12s; }
    }
</style>
