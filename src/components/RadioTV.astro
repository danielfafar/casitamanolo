---
// src/components/RadioTV.astro
//
// Radio y televisión juntas: un televisor viejo cuya pantalla pone una escena
// y cuyo dial cambia la música que suena sobre ella. Cada posición del dial es
// una de las emociones de Radio Manolo.
//
// Pistas y escena salen de src/data/listening.ts, la misma fuente que usan
// /radio y /television, así que para cambiar la música basta con tocar ahí.
import { moods, televisionScene } from '../data/listening';

const emisoras = moods.map((m) => ({
    nombre: m.name.toUpperCase(),
    titulo: m.title,
    src: m.source,
}));

// El dial recorre 270º repartidos entre las emisoras
const ARCO = 270;
const paso = ARCO / (emisoras.length - 1);
---

<!-- Botón de encendido, arriba a la derecha -->
<button class="tv-trigger" id="tv-trigger" aria-expanded="false" aria-controls="tv-panel">
    <svg viewBox="0 0 24 20" aria-hidden="true">
        <rect x="1.5" y="5.5" width="21" height="13" rx="2" />
        <path d="M7 1.5 L12 5.5 L17 1.5" />
    </svg>
    <span>RADIO</span>
</button>

<!-- Panel del televisor -->
<div class="tv-backdrop" id="tv-backdrop"></div>

<section
    class="tv-panel"
    id="tv-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Radio y televisión de la casa"
    data-emisoras={JSON.stringify(emisoras)}
    data-arco={ARCO}
    hidden
>
    <div class="tv-set">
        <!-- Pantalla: la escena de fondo y el canal encima -->
        <div class="tv-screen-frame">
            <div class="tv-screen" id="tv-screen">
                <video
                    class="tv-video"
                    id="tv-video"
                    src={televisionScene.source}
                    poster="/videos/demo-flower-poster.jpg"
                    muted
                    loop
                    playsinline
                    preload="none"
                    aria-label={televisionScene.description}
                ></video>
                <div class="tv-static" aria-hidden="true"></div>

                <div class="tv-osd">
                    <p class="tv-station" id="tv-station">{emisoras[0].nombre}</p>
                    <p class="tv-title" id="tv-title">{emisoras[0].titulo}</p>
                    <div class="tv-eq" aria-hidden="true">
                        <span></span><span></span><span></span><span></span><span></span>
                    </div>
                </div>

                <p class="tv-status" id="tv-status">APAGADA</p>
                <div class="tv-scanlines" aria-hidden="true"></div>
            </div>
        </div>

        <!-- Consola: dial + mandos -->
        <div class="tv-console">
            <div class="tv-dial-zone">
                <div class="tv-dial">
                    <div class="tv-ticks" aria-hidden="true">
                        {emisoras.map((_, i) => (
                            <span class="tv-tick" style={`--angle:${-ARCO / 2 + i * paso}deg`}></span>
                        ))}
                    </div>
                    <div
                        class="tv-knob"
                        id="tv-knob"
                        role="slider"
                        tabindex="0"
                        aria-label="Dial de emisoras"
                        aria-valuemin="1"
                        aria-valuemax={emisoras.length}
                        aria-valuenow="1"
                        aria-valuetext={emisoras[0].nombre}
                    >
                        <span class="tv-knob-mark"></span>
                    </div>
                </div>
                <p class="tv-hint">Gira el dial</p>
            </div>

            <div class="tv-buttons">
                <button class="tv-power" id="tv-power" aria-pressed="false">
                    <span class="tv-led" aria-hidden="true"></span>
                    <span id="tv-power-label">ENCENDER</span>
                </button>
                <ul class="tv-presets">
                    {emisoras.map((e, i) => (
                        <li>
                            <button class="tv-preset" data-index={i} aria-pressed={i === 0 ? 'true' : 'false'}>
                                {e.nombre}
                            </button>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </div>

    <p class="tv-credit"><a href={televisionScene.creditUrl}>{televisionScene.credit}</a></p>

    <button class="tv-close" id="tv-close" aria-label="Cerrar la radio">✕ <span class="tv-kbd">ESC</span></button>

    <audio id="tv-audio" loop preload="none"></audio>
</section>

<script>
    // Script empaquetado: Astro lo ejecuta una sola vez aunque se navegue
    // varias veces al home. Con define:vars iria en linea y se volveria a
    // ejecutar en cada visita, duplicando los listeners hasta que el boton
    // abria y cerraba a la vez. Por eso los datos llegan en data-emisoras.

    type Emisora = { nombre: string; titulo: string; src: string };

    document.addEventListener('astro:page-load', () => {
        const panel = document.getElementById('tv-panel');
        const trigger = document.getElementById('tv-trigger');
        const knob = document.getElementById('tv-knob');
        const audio = document.getElementById('tv-audio') as HTMLAudioElement | null;
        const video = document.getElementById('tv-video') as HTMLVideoElement | null;
        if (!panel || !trigger || !knob || !audio || !video) return;

        const emisoras: Emisora[] = JSON.parse(panel.dataset.emisoras ?? '[]');
        const ARCO = Number(panel.dataset.arco ?? 270);
        const paso = ARCO / Math.max(emisoras.length - 1, 1);
        if (!emisoras.length) return;

        const backdrop = document.getElementById('tv-backdrop');
        const closeBtn = document.getElementById('tv-close');
        const dial = knob.parentElement as HTMLElement;
        const powerBtn = document.getElementById('tv-power') as HTMLButtonElement;
        const powerLabel = document.getElementById('tv-power-label') as HTMLElement;
        const screen = document.getElementById('tv-screen') as HTMLElement;
        const nombreEl = document.getElementById('tv-station') as HTMLElement;
        const tituloEl = document.getElementById('tv-title') as HTMLElement;
        const statusEl = document.getElementById('tv-status') as HTMLElement;
        const presets = [...panel.querySelectorAll<HTMLButtonElement>('.tv-preset')];

        // Todo lo que se engancha a document/window se suelta al salir de la
        // pagina, para no dejar listeners huerfanos entre navegaciones.
        const limpieza = new AbortController();
        const { signal } = limpieza;

        let indice = 0;
        let encendida = false;

        /* ------------------------------------------------------------------
           Pantalla
           ------------------------------------------------------------------ */
        function estado(texto: string, clase: 'is-playing' | 'is-loading' | 'is-nosignal' | null) {
            statusEl.textContent = texto;
            screen.classList.remove('is-playing', 'is-loading', 'is-nosignal');
            if (clase) screen.classList.add(clase);
        }

        function pintarEmisora() {
            const e = emisoras[indice];
            knob.style.transform = `rotate(${-ARCO / 2 + indice * paso}deg)`;
            knob.setAttribute('aria-valuenow', String(indice + 1));
            knob.setAttribute('aria-valuetext', e.nombre);
            nombreEl.textContent = e.nombre;
            tituloEl.textContent = e.titulo;
            presets.forEach((b, i) => b.setAttribute('aria-pressed', i === indice ? 'true' : 'false'));
        }

        /* ------------------------------------------------------------------
           Sintonizar: mueve el dial y cambia la musica
           ------------------------------------------------------------------ */
        function sintonizar(nuevo: number) {
            indice = (nuevo + emisoras.length) % emisoras.length;
            pintarEmisora();
            if (!encendida) return;

            audio.src = emisoras[indice].src;
            estado('SINTONIZANDO', 'is-loading');
            audio.play().catch(() => {
                // Si el archivo no existe, el listener de 'error' lo cuenta
            });
        }

        audio.addEventListener('playing', () => estado('EN ANTENA', 'is-playing'));
        audio.addEventListener('waiting', () => {
            if (encendida) estado('SINTONIZANDO', 'is-loading');
        });
        audio.addEventListener('error', () => {
            if (encendida) estado('SIN SEÑAL', 'is-nosignal');
        });

        /* ------------------------------------------------------------------
           Encendido: la escena y la musica arrancan juntas
           ------------------------------------------------------------------ */
        function alternarEncendido() {
            encendida = !encendida;
            powerBtn.setAttribute('aria-pressed', String(encendida));
            powerLabel.textContent = encendida ? 'APAGAR' : 'ENCENDER';
            screen.classList.toggle('is-on', encendida);

            if (encendida) {
                video.play().catch(() => {});
                sintonizar(indice);
            } else {
                audio.pause();
                video.pause();
                estado('APAGADA', null);
            }
        }
        powerBtn.addEventListener('click', alternarEncendido);

        /* ------------------------------------------------------------------
           Girar el dial: arrastre, teclado y presets
           ------------------------------------------------------------------ */
        let arrastrando = false;

        function indiceDesdePuntero(ev: PointerEvent) {
            const r = dial.getBoundingClientRect();
            const cx = r.left + r.width / 2;
            const cy = r.top + r.height / 2;
            // 0º arriba, positivo en sentido horario
            let ang = (Math.atan2(ev.clientX - cx, cy - ev.clientY) * 180) / Math.PI;
            ang = Math.max(-ARCO / 2, Math.min(ARCO / 2, ang));
            return Math.round((ang + ARCO / 2) / paso);
        }

        knob.addEventListener('pointerdown', (ev) => {
            arrastrando = true;
            knob.setPointerCapture(ev.pointerId);
            knob.classList.add('is-grabbing');
        });
        knob.addEventListener('pointermove', (ev) => {
            if (!arrastrando) return;
            const nuevo = indiceDesdePuntero(ev);
            if (nuevo !== indice) sintonizar(nuevo);
        });
        const soltar = (ev: PointerEvent) => {
            if (!arrastrando) return;
            arrastrando = false;
            knob.classList.remove('is-grabbing');
            if (knob.hasPointerCapture(ev.pointerId)) knob.releasePointerCapture(ev.pointerId);
        };
        knob.addEventListener('pointerup', soltar);
        knob.addEventListener('pointercancel', soltar);

        knob.addEventListener('keydown', (ev) => {
            const teclas: Record<string, number> = {
                ArrowRight: indice + 1,
                ArrowUp: indice + 1,
                ArrowLeft: indice - 1,
                ArrowDown: indice - 1,
                Home: 0,
                End: emisoras.length - 1,
            };
            if (!(ev.key in teclas)) return;
            ev.preventDefault();
            sintonizar(teclas[ev.key]);
        });

        presets.forEach((b) => b.addEventListener('click', () => sintonizar(Number(b.dataset.index))));

        /* ------------------------------------------------------------------
           Abrir y cerrar el panel
           ------------------------------------------------------------------ */
        function abrir() {
            panel.hidden = false;
            // Forzamos el calculo de estilo para que la transicion arranque
            // desde el estado cerrado. Con requestAnimationFrame el panel se
            // quedaba a medias si la pestana no estaba visible.
            void panel.offsetHeight;
            panel.classList.add('is-open');
            backdrop?.classList.add('is-open');
            trigger.setAttribute('aria-expanded', 'true');
            if (encendida) video.play().catch(() => {});
            powerBtn.focus();
        }

        function cerrar() {
            panel.classList.remove('is-open');
            backdrop?.classList.remove('is-open');
            trigger.setAttribute('aria-expanded', 'false');
            // La musica sigue sonando; la escena no hace falta si no se ve
            video.pause();
            trigger.focus();
            setTimeout(() => {
                if (!panel.classList.contains('is-open')) panel.hidden = true;
            }, 400);
        }

        trigger.addEventListener('click', () => (panel.classList.contains('is-open') ? cerrar() : abrir()));
        closeBtn?.addEventListener('click', cerrar);
        backdrop?.addEventListener('click', cerrar);
        document.addEventListener(
            'keydown',
            (ev) => {
                if (ev.key === 'Escape' && panel.classList.contains('is-open')) cerrar();
            },
            { signal }
        );

        // Chrome pausa los videos silenciados de las pestanas ocultas. La
        // musica sigue, pero al volver la escena se quedaba congelada.
        document.addEventListener(
            'visibilitychange',
            () => {
                if (document.visibilityState === 'visible' && encendida && panel.classList.contains('is-open')) {
                    video.play().catch(() => {});
                }
            },
            { signal }
        );

        // Al irse a otra pagina: silencio y fuera listeners
        document.addEventListener(
            'astro:before-swap',
            () => {
                audio.pause();
                video.pause();
                limpieza.abort();
            },
            { once: true, signal }
        );

        pintarEmisora();
        estado('APAGADA', null);
    });
</script>

<style>
    /* ========================================================
       BOTÓN DE ARRIBA
       ======================================================== */
    .tv-trigger {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 60;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 16px;
        border-radius: 30px;
        border: 1px solid rgba(17, 35, 30, 0.25);
        background: rgba(244, 241, 236, 0.75);
        backdrop-filter: blur(6px);
        color: var(--ink-color, #11231E);
        font-family: 'Space Mono', monospace;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        cursor: pointer;
        transition: transform 0.25s var(--ease-spring, ease), background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    }
    .tv-trigger svg {
        width: 17px;
        height: auto;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .tv-trigger:hover,
    .tv-trigger:focus-visible {
        background: var(--accent-color, #D74F42);
        border-color: var(--accent-color, #D74F42);
        color: #F4F1EC;
        transform: scale(1.04);
    }
    .tv-trigger:active { transform: scale(0.96); }
    .tv-trigger[aria-expanded='true'] { background: var(--ink-color, #11231E); border-color: var(--ink-color, #11231E); color: #F4F1EC; }

    /* ========================================================
       PANEL
       ======================================================== */
    .tv-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(11, 23, 20, 0.82);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.4s var(--ease-out, ease);
        z-index: 70;
    }
    .tv-backdrop.is-open { opacity: 1; pointer-events: auto; }

    .tv-panel {
        position: fixed;
        top: 50%;
        left: 50%;
        z-index: 80;
        transform: translate(-50%, -50%) scale(0.88);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.35s var(--ease-out, ease), transform 0.45s var(--ease-spring, ease);
    }
    .tv-panel[hidden] { display: none; }
    .tv-panel.is-open { opacity: 1; transform: translate(-50%, -50%) scale(1); pointer-events: auto; }

    /* ========================================================
       EL MUEBLE
       ======================================================== */
    .tv-set {
        width: min(440px, 90vw);
        padding: 22px 22px 18px;
        border-radius: 18px;
        background: linear-gradient(165deg, #6b4227 0%, #4a2c18 55%, #35200f 100%);
        box-shadow: 0 30px 70px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.14);
        font-family: 'Space Mono', monospace;
    }

    .tv-screen-frame {
        padding: 12px;
        border-radius: 14px;
        background: #1c1109;
        box-shadow: inset 0 3px 10px rgba(0, 0, 0, 0.8);
    }

    .tv-screen {
        position: relative;
        aspect-ratio: 4 / 3;
        border-radius: 10px / 14px;
        overflow: hidden;
        background: radial-gradient(ellipse at 50% 45%, #14302a 0%, #08150f 75%);
        color: #F4F1EC;
    }

    /* La escena solo se ve con la tele encendida */
    .tv-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        filter: saturate(0.85) contrast(1.05);
        transition: opacity 0.6s ease;
    }
    .tv-screen.is-on .tv-video { opacity: 1; }

    /* Rótulo del canal, abajo a la izquierda como en una tele */
    .tv-osd {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 2;
        padding: 30px 16px 14px;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.65));
        opacity: 0;
        transition: opacity 0.4s ease;
    }
    .tv-screen.is-on .tv-osd { opacity: 1; }

    .tv-station {
        margin: 0;
        font-size: clamp(1rem, 4.5vw, 1.4rem);
        font-weight: 700;
        letter-spacing: 0.16em;
        text-shadow: 0 1px 6px rgba(0, 0, 0, 0.7);
    }
    .tv-title {
        margin: 2px 0 0;
        font-size: 0.65rem;
        letter-spacing: 0.12em;
        opacity: 0.8;
    }

    .tv-eq {
        position: absolute;
        right: 16px;
        bottom: 16px;
        display: flex;
        align-items: flex-end;
        gap: 3px;
        height: 18px;
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    .tv-eq span { width: 3px; height: 4px; border-radius: 1px; background: #F4F1EC; }
    .tv-screen.is-playing .tv-eq { opacity: 0.9; }
    .tv-screen.is-playing .tv-eq span { animation: eq 0.9s ease-in-out infinite alternate; }
    .tv-screen.is-playing .tv-eq span:nth-child(2) { animation-delay: -0.2s; }
    .tv-screen.is-playing .tv-eq span:nth-child(3) { animation-delay: -0.5s; }
    .tv-screen.is-playing .tv-eq span:nth-child(4) { animation-delay: -0.3s; }
    .tv-screen.is-playing .tv-eq span:nth-child(5) { animation-delay: -0.7s; }
    @keyframes eq { from { height: 4px; } to { height: 16px; } }

    /* Estado: centrado cuando está apagada, discreto arriba cuando suena */
    .tv-status {
        position: absolute;
        z-index: 2;
        inset: 0;
        margin: 0;
        display: grid;
        place-items: center;
        font-size: 0.6rem;
        letter-spacing: 0.3em;
        color: #8ee4b8;
        opacity: 0.45;
        transition: opacity 0.3s ease;
    }
    .tv-screen.is-on .tv-status { inset: 12px 14px auto auto; display: block; font-size: 0.5rem; opacity: 0.75; }
    .tv-screen.is-nosignal .tv-status { color: #e8b059; }

    .tv-static {
        position: absolute;
        inset: 0;
        z-index: 1;
        opacity: 0;
        transition: opacity 0.3s ease;
        background-image: repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.09) 0px, rgba(255, 255, 255, 0.09) 1px, transparent 1px, transparent 3px);
    }
    .tv-screen.is-nosignal .tv-static { opacity: 1; animation: nieve 0.35s steps(2) infinite; }
    @keyframes nieve { to { transform: translateY(3px); } }

    .tv-scanlines {
        position: absolute;
        inset: 0;
        z-index: 3;
        pointer-events: none;
        background-image: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.2) 0px, rgba(0, 0, 0, 0.2) 1px, transparent 1px, transparent 3px);
    }

    /* ========================================================
       CONSOLA: DIAL Y BOTONES
       ======================================================== */
    .tv-console {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-top: 16px;
    }

    .tv-dial-zone { flex-shrink: 0; text-align: center; }

    .tv-dial {
        position: relative;
        width: 96px;
        height: 96px;
        border-radius: 50%;
        background: radial-gradient(circle at 38% 32%, #4b4b4b, #1d1d1d 70%);
        box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.7), 0 3px 8px rgba(0, 0, 0, 0.45);
        display: grid;
        place-items: center;
    }

    .tv-ticks { position: absolute; inset: 0; }
    .tv-tick {
        position: absolute;
        top: 5px;
        left: 50%;
        width: 2px;
        height: 7px;
        border-radius: 1px;
        background: rgba(232, 176, 89, 0.65);
        transform-origin: 50% 43px;
        transform: translateX(-50%) rotate(var(--angle));
    }

    .tv-knob {
        position: relative;
        width: 62px;
        height: 62px;
        border-radius: 50%;
        background: linear-gradient(150deg, #e9e4d8, #b9b1a0);
        box-shadow: 0 3px 7px rgba(0, 0, 0, 0.5), inset 0 -2px 5px rgba(0, 0, 0, 0.25);
        cursor: grab;
        touch-action: none;
        transition: transform 0.35s var(--ease-spring, ease);
        outline: none;
    }
    .tv-knob.is-grabbing { cursor: grabbing; transition: none; }
    .tv-knob:focus-visible { box-shadow: 0 0 0 3px #D74F42, 0 3px 7px rgba(0, 0, 0, 0.5); }

    .tv-knob-mark {
        position: absolute;
        top: 7px;
        left: 50%;
        transform: translateX(-50%);
        width: 3px;
        height: 16px;
        border-radius: 2px;
        background: #D74F42;
    }

    .tv-hint {
        margin: 8px 0 0;
        font-size: 0.5rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(244, 241, 236, 0.45);
    }

    .tv-buttons { flex: 1; min-width: 0; }

    .tv-power {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        justify-content: center;
        padding: 9px 12px;
        border-radius: 6px;
        border: 1px solid rgba(244, 241, 236, 0.2);
        background: rgba(0, 0, 0, 0.3);
        color: #F4F1EC;
        font-family: inherit;
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        cursor: pointer;
        transition: background 0.25s ease, border-color 0.25s ease;
    }
    .tv-power:hover { background: rgba(0, 0, 0, 0.5); border-color: rgba(244, 241, 236, 0.4); }

    .tv-led {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #3a2a1c;
        transition: background 0.3s ease, box-shadow 0.3s ease;
    }
    .tv-power[aria-pressed='true'] .tv-led { background: #D74F42; box-shadow: 0 0 8px #D74F42; }

    .tv-presets {
        list-style: none;
        margin: 10px 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 5px;
    }
    .tv-preset {
        width: 100%;
        padding: 8px 2px;
        border-radius: 4px;
        border: 1px solid rgba(244, 241, 236, 0.14);
        background: rgba(0, 0, 0, 0.22);
        color: rgba(244, 241, 236, 0.6);
        font-family: inherit;
        font-size: 0.5rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }
    .tv-preset:hover { color: #F4F1EC; border-color: rgba(244, 241, 236, 0.4); }
    .tv-preset[aria-pressed='true'] { background: #D74F42; border-color: #D74F42; color: #F4F1EC; }

    .tv-credit {
        margin: 10px 0 0;
        text-align: center;
        font-family: 'Space Mono', monospace;
        font-size: 0.5rem;
        letter-spacing: 0.05em;
    }
    .tv-credit a { color: rgba(244, 241, 236, 0.4); }
    .tv-credit a:hover { color: rgba(244, 241, 236, 0.8); }

    /* ========================================================
       CERRAR
       ======================================================== */
    .tv-close {
        position: absolute;
        top: -46px;
        right: 0;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 14px;
        border-radius: 30px;
        border: 1px solid rgba(244, 241, 236, 0.3);
