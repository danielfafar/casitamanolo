---
// src/components/Tiradores.astro
//
// El selector de idioma de la casa: los tiradores de la barra. Cada idioma
// tiene su cerveza (src/i18n/cervezas.ts). El del idioma que se está leyendo
// está bajado, como el que acaban de tirar; los otros salen al pasar el ratón
// o al tocarlo, y son enlaces de verdad a la misma página en ese idioma.
import { idiomas, enlace, type Idioma } from '../i18n/config';
import { cervezas } from '../i18n/cervezas';
import { textos } from '../i18n/textos';

interface Props {
    /** Idioma que se está pintando */
    idioma: Idioma;
    /** Página actual sin prefijo de idioma: '/', '/portfolio'… */
    destino: string;
}

const { idioma, destino } = Astro.props;
const T = textos[idioma];
const otros = idiomas.filter((otro) => otro !== idioma);
const puesto = (cual: Idioma) => idiomas.indexOf(cual);
---

<div class="tiradores" id="tiradores">
    <!-- El tirador bajado: el idioma que se está leyendo, y el que abre los demás -->
    <button
        type="button"
        class="tirador tirador--puesto"
        id="tiradores-abrir"
        aria-expanded="false"
        aria-controls="tiradores-lista"
        aria-label={`${T.comun.idioma}: ${cervezas[idioma].idioma}`}
        aria-current="true"
        style={`order: ${puesto(idioma)}`}
    >
        <span class="tirador-dibujo">
            <svg viewBox="0 0 58 108" aria-hidden="true">
                <g class="tirador-asa">
                    <rect x="3" y="2" width="52" height="66" rx="5" fill={cervezas[idioma].fondo} stroke={cervezas[idioma].borde} stroke-width="2" />
                    {cervezas[idioma].emblema === 'estrella' ? (
                        <path d="M29 10 l3 6.2 6.8 1 -4.9 4.8 1.2 6.8 -6.1-3.2 -6.1 3.2 1.2-6.8 -4.9-4.8 6.8-1z" fill={cervezas[idioma].emblemaColor} />
                    ) : (
                        <g>
                            <circle cx="29" cy="19" r="9.5" fill={cervezas[idioma].emblemaColor} />
                            <text x="29" y="23.5" text-anchor="middle" font-size="12" font-weight="700" fill={cervezas[idioma].emblemaTinta}>M</text>
                        </g>
                    )}
                    <text x="29" y="47" text-anchor="middle" font-size="17" font-weight="700" letter-spacing="1" fill={cervezas[idioma].tinta}>{cervezas[idioma].codigo}</text>
                    <text x="29" y="56" text-anchor="middle" font-size="6" letter-spacing="0.6" fill={cervezas[idioma].tintaSuave}>{cervezas[idioma].marca}</text>
                    <text x="29" y="63.5" text-anchor="middle" font-size="5" letter-spacing="0.4" fill={cervezas[idioma].tintaSuave}>{cervezas[idioma].variedad}</text>
                    <rect x="25" y="68" width="8" height="14" fill="#b9bcbf" />
                </g>
                <rect x="14" y="80" width="30" height="20" rx="5" fill="#c9ccd0" />
                <rect x="24" y="100" width="10" height="7" rx="1.5" fill="#9ea2a6" />
            </svg>
        </span>
    </button>

    <!-- Los otros idiomas, cada uno con su cerveza -->
    <ul class="tiradores-lista" id="tiradores-lista">
        {otros.map((otro) => (
            <li style={`order: ${puesto(otro)}`}>
                <a
                    class="tirador"
                    href={enlace(destino, otro)}
                    lang={otro}
                    hreflang={otro}
                    aria-label={`${T.comun.cambiarA} ${cervezas[otro].idioma}`}
                >
                    <span class="tirador-dibujo">
                        <svg viewBox="0 0 58 108" aria-hidden="true">
                            <g class="tirador-asa">
                                <rect x="3" y="2" width="52" height="66" rx="5" fill={cervezas[otro].fondo} stroke={cervezas[otro].borde} stroke-width="2" />
                                {cervezas[otro].emblema === 'estrella' ? (
                                    <path d="M29 10 l3 6.2 6.8 1 -4.9 4.8 1.2 6.8 -6.1-3.2 -6.1 3.2 1.2-6.8 -4.9-4.8 6.8-1z" fill={cervezas[otro].emblemaColor} />
                                ) : (
                                    <g>
                                        <circle cx="29" cy="19" r="9.5" fill={cervezas[otro].emblemaColor} />
                                        <text x="29" y="23.5" text-anchor="middle" font-size="12" font-weight="700" fill={cervezas[otro].emblemaTinta}>M</text>
                                    </g>
                                )}
                                <text x="29" y="47" text-anchor="middle" font-size="17" font-weight="700" letter-spacing="1" fill={cervezas[otro].tinta}>{cervezas[otro].codigo}</text>
                                <text x="29" y="56" text-anchor="middle" font-size="6" letter-spacing="0.6" fill={cervezas[otro].tintaSuave}>{cervezas[otro].marca}</text>
                                <text x="29" y="63.5" text-anchor="middle" font-size="5" letter-spacing="0.4" fill={cervezas[otro].tintaSuave}>{cervezas[otro].variedad}</text>
                                <rect x="25" y="68" width="8" height="14" fill="#b9bcbf" />
                            </g>
                            <rect x="14" y="80" width="30" height="20" rx="5" fill="#c9ccd0" />
                            <rect x="24" y="100" width="10" height="7" rx="1.5" fill="#9ea2a6" />
                        </svg>
                    </span>
                </a>
            </li>
        ))}
    </ul>

    <!-- El canto de la barra, para que los grifos se apoyen en algo -->
    <span class="tiradores-barra" aria-hidden="true"></span>
</div>

<style>
    /* En el ordenador los grifos van arriba, en el centro, apoyados en el
       canto de la barra. La esquina de abajo a la derecha esta ocupada por
       el distintivo de Netlify y ahi se peleaban. */
    .tiradores {
        position: fixed;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        z-index: 200;
        display: flex;
        align-items: flex-end;
        gap: 3px;
    }

    .tiradores-lista {
        display: flex;
        align-items: flex-end;
        gap: 3px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .tirador {
        display: block;
        margin: 0;
        padding: 0;
        border: none;
        background: none;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }

    .tirador-dibujo {
        display: block;
        width: 52px;
        /* Sombra corta y suave: la de antes era un borron sobre el papel */
        filter: drop-shadow(0 2px 3px rgba(17, 35, 30, 0.22));
    }
    .tirador svg { display: block; width: 100%; height: auto; }

    /* El asa gira sobre el cuerpo del grifo: puesto = bajado hacia delante */
    .tirador-asa {
        transform-box: fill-box;
        transform-origin: 50% 100%;
        transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    }
    .tirador--puesto .tirador-asa { transform: rotate(16deg); }
    .tirador:not(.tirador--puesto):hover .tirador-asa,
    .tirador:not(.tirador--puesto):focus-visible .tirador-asa { transform: rotate(10deg); }

    .tirador:focus-visible { outline: 3px solid #E8B059; outline-offset: 3px; border-radius: 6px; }

    /* El canto de la barra donde se apoyan */
    .tiradores-barra {
        position: absolute;
        left: -10px;
        right: -10px;
        bottom: -5px;
        height: 7px;
        border-radius: 0 0 4px 4px;
        background: linear-gradient(#5a381f, #35200f);
        box-shadow: 0 2px 4px rgba(17, 35, 30, 0.2);
        z-index: -1;
    }

    /* En el movil no hay sitio arriba (ahi van el volver y el indicador), asi
       que bajan a la esquina de la izquierda, lejos de las flechas y del
       distintivo de Netlify. Se ve solo el idioma puesto y los demas salen
       al tocarlo. */
    @media (max-width: 680px) {
        .tiradores {
            top: auto;
            bottom: 12px;
            left: 10px;
            transform: none;
        }

        .tirador-dibujo { width: 46px; }

        /* Los demas salen hacia arriba, no hacia el lado: asi no se ponen
           encima de la flecha de cambiar de mesa o de estacion */
        .tiradores, .tiradores-lista { flex-direction: column-reverse; align-items: flex-start; }

        .tiradores-lista {
            max-height: 0;
            opacity: 0;
            overflow: hidden;
            transition: max-height 0.45s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.3s ease;
        }
        .tiradores.is-abierto .tiradores-lista { max-height: 320px; opacity: 1; }
    }

    @media (prefers-reduced-motion: reduce) {
        .tiradores-lista, .tirador-asa { transition: none; }
    }
</style>

<script>
    // Un toque abre los otros tiradores; con ratón basta pasar por encima.
    // El enlace de cada tirador funciona igual sin JavaScript.
    document.addEventListener('astro:page-load', () => {
        const caja = document.getElementById('tiradores');
        const abrir = document.getElementById('tiradores-abrir');
        if (!caja || !abrir) return;

        const limpieza = new AbortController();
        const { signal } = limpieza;
        document.addEventListener('astro:before-swap', () => limpieza.abort(), { once: true });

        // Arriba se ven todos a la vez: ahi el boton no despliega nada
        const plegados = window.matchMedia('(max-width: 680px)');

        const ajustarBoton = () => {
            if (plegados.matches) abrir.setAttribute('aria-expanded', String(caja.classList.contains('is-abierto')));
            else abrir.removeAttribute('aria-expanded');
        };
        ajustarBoton();
        plegados.addEventListener('change', ajustarBoton, { signal });

        const cerrar = () => {
            caja.classList.remove('is-abierto');
            ajustarBoton();
        };

        abrir.addEventListener('click', () => {
            if (!plegados.matches) return;
            caja.classList.toggle('is-abierto');
            ajustarBoton();
        }, { signal });

        document.addEventListener('click', (ev) => {
            if (!caja.contains(ev.target as Node)) cerrar();
        }, { signal });

        document.addEventListener('keydown', (ev) => {
            if (ev.key === 'Escape') cerrar();
        }, { signal });
    });
</script>
