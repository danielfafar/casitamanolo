---
// src/pages/portfolio.astro
import { ClientRouter } from 'astro:transitions';
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Casita Manolo | Archivo Musical</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <ClientRouter />
    
    <style>
        /* ========================================================
           1. RESET & VARIABLES
           ======================================================== */
        :root {
            --bg-color: #11231E; 
            --text-color: #F4F1EC; 
            --accent-color: #D74F42; 
            --ease-spring: cubic-bezier(0.175, 0.885, 0.32, 1.2);
            --ease-slide: cubic-bezier(0.65, 0, 0.35, 1);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body, html {
            width: 100%; height: 100%;
            background-color: var(--bg-color); color: var(--text-color);
            font-family: 'Space Mono', monospace;
            overflow: hidden; user-select: none;
        }

        /* ========================================================
           2. NAVEGACIÓN Y UI SUPERIOR
           ======================================================== */
        .portfolio-main {
            position: relative; width: 100vw; height: 100vh;
            display: flex; align-items: center; justify-content: center;
        }

        .header-ui {
            position: absolute; top: 40px; width: 100%;
            display: flex; justify-content: space-between; padding: 0 50px;
            pointer-events: none; z-index: 100;
        }

        .section-title { opacity: 0.3; font-size: 0.75rem; letter-spacing: 0.4em; text-transform: uppercase;}

        .btn-volver {
            pointer-events: auto; color: var(--text-color); text-decoration: none;
            font-size: 0.75rem; font-weight: 700; letter-spacing: 0.3em; text-transform: uppercase;
            transition: color 0.3s, transform 0.3s;
        }
        .btn-volver:hover { color: var(--accent-color); transform: translateX(-5px); }

        /* Controles del Carrusel */
        .nav-btn {
            position: absolute; top: 50%; transform: translateY(-50%);
            background: transparent; border: none; color: var(--text-color);
            font-size: 2rem; cursor: pointer; opacity: 0.3;
            transition: opacity 0.3s, transform 0.3s; z-index: 100; padding: 20px;
        }
        .nav-btn:hover { opacity: 1; transform: translateY(-50%) scale(1.2); }
        .nav-btn:disabled { opacity: 0; pointer-events: none; }
        #btn-prev { left: 20px; }
        #btn-next { right: 20px; }

        /* ========================================================
           3. EL MONITOR DE VÍDEO
           ======================================================== */
        .video-presentation {
            position: absolute; left: 5%; width: 45vw; aspect-ratio: 16/9;
            background-color: #08110e; border-radius: 12px; overflow: hidden;
            box-shadow: 0 30px 60px rgba(0,0,0,0.8); border: 1px solid rgba(244,241,236,0.1);
            
            opacity: 0; pointer-events: none;
            transform: translateX(-50px) scale(0.95); transition: all 0.8s var(--ease-spring);
            z-index: 40;
        }

        .video-presentation video { width: 100%; height: 100%; object-fit: cover; opacity: 0.8; }

        body.video-active .video-presentation { opacity: 1; transform: translateX(0) scale(1); }

        /* ========================================================
           4. EL SALÓN (Contiene el carrusel de estaciones)
           ======================================================== */
        .venue {
            width: 100%; height: 100%; overflow: hidden;
            transform: translateX(0) scale(1);
            transition: transform 0.8s var(--ease-spring);
        }

        body.video-active .venue {
            transform: translateX(20vw) scale(0.9);
        }

        .stations-track {
            display: flex; height: 100%; width: 100%;
            transform: translateX(0%); transition: transform 0.8s var(--ease-slide);
        }

        .station {
            flex: 0 0 100vw; height: 100%; display: flex; align-items: center; justify-content: center; position: relative;
        }

        .jukebox-stage {
            width: 100%; max-width: 1100px; display: flex; flex-direction: row;
            align-items: center; justify-content: space-between; gap: 40px; z-index: 10;
        }

        .station-bg-text {
            position: absolute; top: 15%; width: 100%; text-align: center;
            font-size: clamp(4rem, 10vw, 8rem); font-weight: 700; color: rgba(244,241,236,0.02);
            letter-spacing: 0.1em; z-index: 0; pointer-events: none;
        }

        .rack { display: flex; flex-direction: column; gap: 50px; z-index: 20; }

        /* ========================================================
           5. DISCOS Y CARÁTULAS
           ======================================================== */
        .sleeve-container { position: relative; width: 160px; height: 160px; }

        .album-cover {
            position: absolute; inset: 0; z-index: 20; border-radius: 4px;
            background-size: cover; background-position: center;
            box-shadow: 0 15px 35px rgba(0,0,0,0.6); cursor: pointer;
            display: flex; align-items: center; justify-content: center; text-align: center;
            transition: transform 0.4s var(--ease-spring), box-shadow 0.4s ease;
            border: 1px solid rgba(244,241,236,0.1);
        }

        .cover-text {
            font-size: 1.1rem; font-weight: 700; letter-spacing: 0.2em; line-height: 1.4;
            color: var(--bg-color); background-color: rgba(244,241,236,0.7);
            width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; pointer-events: none;
        }

        .sleeve-container:hover .album-cover { transform: scale(1.05); box-shadow: 0 20px 40px rgba(0,0,0,0.8); }

        .vinyl-wrapper {
            position: absolute; top: 2px; left: 2px; width: 156px; height: 156px;
            z-index: 10; touch-action: none; cursor: grab;
        }
        .vinyl-wrapper.dragging { cursor: grabbing; z-index: 60 !important; }
        .vinyl-art { width: 100%; height: 100%; filter: drop-shadow(0 10px 15px rgba(0,0,0,0.5)); }

        @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        .vinyl-wrapper.playing .vinyl-art { animation: spin 3s linear infinite; }

        /* ========================================================
           6. EL TOCADISCOS (Múltiples Estilos)
           ======================================================== */
        .turntable-wrapper {
            position: relative; width: 400px; height: 400px; display: flex; flex-direction: column;
            align-items: center; justify-content: center; flex-shrink: 0;
        }

        .turntable-base {
            position: absolute; inset: 0; border-radius: 50%;
            box-shadow: inset 0 10px 30px rgba(0,0,0,0.8), 0 20px 40px rgba(0,0,0,0.5);
        }

        .dropzone {
            width: 300px; height: 300px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
            position: relative; transition: border-color 0.3s ease, background-color 0.3s ease; z-index: 10;
        }

        .platter-ring { position: absolute; border-radius: 50%; border: 1px solid rgba(244,241,236,0.03); pointer-events: none; }
        .platter-ring.r1 { width: 260px; height: 260px; }
        .platter-ring.r2 { width: 200px; height: 200px; }

        .dropzone-text {
            position: absolute; font-size: 0.65rem; letter-spacing: 0.3em;
            color: rgba(244,241,236,0.3); text-align: center; pointer-events: none; line-height: 1.5;
        }

        .spindle { width: 16px; height: 16px; background-color: #b0b8b5; border-radius: 50%; box-shadow: 0 4px 6px rgba(0,0,0,0.5); z-index: 0; }

        .tonearm {
            position: absolute; top: 30px; right: 40px; width: 100px; height: 180px;
            pointer-events: none; transition: transform 0.7s ease-in-out; 
            transform-origin: 80px 20px; z-index: 40;
        }
        .tonearm-active { transform: rotate(24deg); }

        /* Estilos específicos Estación 1 (Original Oscuro) */
        .station-1 .turntable-base { background-color: #0d1b17; border: 1px solid #1a332a; }
        .station-1 .dropzone { background-color: #08110e; border: 2px solid #1a332a; }
        .station-1 .dropzone.active-hover { border-color: #D74F42; background-color: #15241f; }

        /* Estilos específicos Estación 2 (Naranja Retro) */
        .station-2 .turntable-base { background: linear-gradient(135deg, #b34a1c, #80300d); border: 1px solid #d35400; }
        .station-2 .dropzone { background-color: #4a1900; border: 2px solid #a03c14; }
        .station-2 .dropzone.active-hover { border-color: #f39c12; background-color: #6a2400; }

        /* ========================================================
           7. HUD DEL PROYECTO
           ======================================================== */
        .project-hud {
            position: absolute; bottom: -90px; display: flex; flex-direction: column; align-items: center;
            opacity: 0; pointer-events: none; transition: opacity 0.7s ease; z-index: 50;
        }

        .playing-indicator { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
        .red-dot { width: 8px; height: 8px; background-color: var(--accent-color); border-radius: 50%; animation: pulse 1.5s infinite; }
        @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.3; } 100% { opacity: 1; } }
        .playing-text { font-size: 0.6rem; letter-spacing: 0.3em; color: var(--accent-color); }

        .project-title { font-size: 2rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; text-align: center; }
    </style>
</head>
<body>

    <main class="portfolio-main">
        
        <!-- MONITOR DE VÍDEO -->
        <div class="video-presentation">
            <video id="project-video" loop muted playsinline>
                <source src="" type="video/mp4" />
            </video>
        </div>

        <audio id="player-audio" loop>
            <source src="/sounds/placeholder.mp3" type="audio/mpeg" />
        </audio>

        <!-- UI SUPERIOR -->
        <div class="header-ui">
            <div class="section-title" id="station-indicator">ESTACIÓN 1 / 2</div>
            <a href="/" class="btn-volver">← VOLVER A CASA</a>
        </div>

        <!-- FLECHAS -->
        <button class="nav-btn" id="btn-prev" disabled>◄</button>
        <button class="nav-btn" id="btn-next">►</button>

        <!-- EL RECINTO -->
        <div class="venue">
            <div class="stations-track" id="stations-track">
                
                <!-- ==============================================
                     ESTACIÓN 1: DESARROLLO (Oscuro)
                     ============================================== -->
                <section class="station station-1">
                    <div class="station-bg-text">WEB DEVELOP</div>
                    <div class="jukebox-stage">
                        
                        <!-- RACK IZQ (Estación 1) -->
                        <div class="rack">
                            <div class="sleeve-container" data-peek="35" data-slide="160" data-title="EL MADRILEÑO" data-video="/videos/interior.mp4">
                                <div class="vinyl-wrapper"><svg viewBox="0 0 100 100" class="vinyl-art"><circle cx="50" cy="50" r="48" fill="#0b1714" stroke="#223b33" stroke-width="0.5"/><circle cx="50" cy="50" r="38" stroke="#1a2e28" stroke-width="1" fill="none"/><circle cx="50" cy="50" r="28" stroke="#1a2e28" stroke-width="1" fill="none"/><circle cx="50" cy="50" r="16" fill="#D74F42"/><circle cx="50" cy="50" r="2" fill="#F4F1EC"/></svg></div>
                                <div class="album-cover" style="background-image: url('/images/placeholder-1.jpg');"><span class="cover-text">01<br>MADRILEÑO</span></div>
                            </div>
                            <div class="sleeve-container" data-peek="35" data-slide="160" data-title="GIRA 2024">
                                <div class="vinyl-wrapper"><svg viewBox="0 0 100 100" class="vinyl-art"><circle cx="50" cy="50" r="48" fill="#0b1714" stroke="#223b33" stroke-width="0.5"/><circle cx="50" cy="50" r="38" stroke="#1a2e28" stroke-width="1" fill="none"/><circle cx="50" cy="50" r="28" stroke="#1a2e28" stroke-width="1" fill="none"/><circle cx="50" cy="50" r="16" fill="#E8B059"/><circle cx="50" cy="50" r="2" fill="#F4F1EC"/></svg></div>
                                <div class="album-cover" style="background-color: #E8B059;"><span class="cover-text" style="background-color: rgba(17,35,30,0.7); color: #F4F1EC;">02<br>GIRA</span></div>
                            </div>
                        </div>

                        <!-- TOCADISCOS (Estación 1) -->
                        <div class="turntable-wrapper">
                            <div class="turntable-base"></div>
                            <div class="dropzone"> 
                                <div class="platter-ring r1"></div><div class="platter-ring r2"></div>
                                <div class="dropzone-text">ARRASTRA<br>EL DISCO</div>
                                <div class="spindle"></div>
                            </div>
                            <svg viewBox="0 0 100 180" class="tonearm"> 
                                <circle cx="80" cy="20" r="14" fill="#1a332a" stroke="#08110e" stroke-width="2"/>
                                <circle cx="80" cy="20" r="4" fill="#b0b8b5"/>
                                <path d="M 80 20 L 40 120 L 20 140" fill="none" stroke="#b0b8b5" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                                <rect x="11" y="130" width="18" height="30" fill="#2a3b35" rx="2" transform="rotate(45 20 140)"/>
                            </svg>
                            <div class="project-hud"> 
                                <div class="playing-indicator"><div class="red-dot"></div><span class="playing-text">REPRODUCIENDO</span></div>
                                <h2 class="project-title">Título</h2>
                            </div>
                        </div>

                        <!-- RACK DER (Estación 1) -->
                        <div class="rack">
                            <div class="sleeve-container" data-peek="-35" data-slide="-160" data-title="SESIONES VIVO">
                                <div class="vinyl-wrapper"><svg viewBox="0 0 100 100" class="vinyl-art"><circle cx="50" cy="50" r="48" fill="#0b1714" stroke="#223b33" stroke-width="0.5"/><circle cx="50" cy="50" r="38" stroke="#1a2e28" stroke-width="1" fill="none"/><circle cx="50" cy="50" r="28" stroke="#1a2e28" stroke-width="1" fill="none"/><circle cx="50" cy="50" r="16" fill="#5982e8"/><circle cx="50" cy="50" r="2" fill="#F4F1EC"/></svg></div>
                                <div class="album-cover" style="background-color: #5982e8;"><span class="cover-text" style="background-color: rgba(17,35,30,0.7); color: #F4F1EC;">03<br>SESIONES</span></div>
                            </div>
                        </div>

                    </div>
                </section>

                <!-- ==============================================
                     ESTACIÓN 2: BRANDING (Naranja/Retro)
                     ============================================== -->
                <section class="station station-2">
                    <div class="station-bg-text">BRANDING</div>
                    <div class="jukebox-stage">
                        
                        <!-- RACK IZQ (Estación 2) -->
                        <div class="rack">
                            <div class="sleeve-container" data-peek="35" data-slide="160" data-title="LOGOTIPO">
                                <div class="vinyl-wrapper"><svg viewBox="0 0 100 100" class="vinyl-art"><circle cx="50" cy="50" r="48" fill="#222" stroke="#333" stroke-width="0.5"/><circle cx="50" cy="50" r="38" stroke="#111" stroke-width="1" fill="none"/><circle cx="50" cy="50" r="28" stroke="#111" stroke-width="1" fill="none"/><circle cx="50" cy="50" r="16" fill="#f39c12"/><circle cx="50" cy="50" r="2" fill="#FFF"/></svg></div>
                                <div class="album-cover" style="background-color: #f39c12;"><span class="cover-text">01<br>LOGO</span></div>
                            </div>
                        </div>

                        <!-- TOCADISCOS (Estación 2) -->
                        <div class="turntable-wrapper">
                            <div class="turntable-base"></div>
                            <div class="dropzone">
                                <div class="platter-ring r1"></div><div class="platter-ring r2"></div>
                                <div class="dropzone-text">ARRASTRA<br>EL DISCO</div>
                                <div class="spindle"></div>
                            </div>
                            <svg viewBox="0 0 100 180" class="tonearm">
                                <circle cx="80" cy="20" r="14" fill="#333" stroke="#111" stroke-width="2"/>
                                <circle cx="80" cy="20" r="4" fill="#ddd"/>
                                <path d="M 80 20 L 40 120 L 20 140" fill="none" stroke="#ddd" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                                <rect x="11" y="130" width="18" height="30" fill="#f39c12" rx="2" transform="rotate(45 20 140)"/>
                            </svg>
                            <div class="project-hud">
                                <div class="playing-indicator"><div class="red-dot"></div><span class="playing-text">REPRODUCIENDO</span></div>
                                <h2 class="project-title">Título</h2>
                            </div>
                        </div>

                        <!-- RACK DER (Estación 2) -->
                        <div class="rack">
                            <div class="sleeve-container" data-peek="-35" data-slide="-160" data-title="PACKAGING">
                                <div class="vinyl-wrapper"><svg viewBox="0 0 100 100" class="vinyl-art"><circle cx="50" cy="50" r="48" fill="#222" stroke="#333" stroke-width="0.5"/><circle cx="50" cy="50" r="38" stroke="#111" stroke-width="1" fill="none"/><circle cx="50" cy="50" r="28" stroke="#111" stroke-width="1" fill="none"/><circle cx="50" cy="50" r="16" fill="#27ae60"/><circle cx="50" cy="50" r="2" fill="#FFF"/></svg></div>
                                <div class="album-cover" style="background-color: #27ae60;"><span class="cover-text">02<br>PACK</span></div>
                            </div>
                        </div>

                    </div>
                </section>

            </div>
        </div>
    </main>

    <script>
        document.addEventListener('astro:page-load', () => {
            const body = document.body;
            const track = document.getElementById('stations-track');
            const btnPrev = document.getElementById('btn-prev');
            const btnNext = document.getElementById('btn-next');
            const indicator = document.getElementById('station-indicator');
            
            const sleeves = document.querySelectorAll('.sleeve-container');
            const audioPlayer = document.getElementById('player-audio') as HTMLAudioElement;
            const videoPlayer = document.getElementById('project-video') as HTMLVideoElement;

            if (!track || !btnPrev || !btnNext) return;

            // --- LÓGICA DEL CARRUSEL ---
            const stations = track.querySelectorAll('.station');
            const totalStations = stations.length;
            let currentIndex = 0;
            let activeVinyl = null; 

            function updateCarousel() {
                track.style.transform = `translateX(-${currentIndex * 100}vw)`;
                if(indicator) indicator.textContent = `ESTACIÓN ${currentIndex + 1} / ${totalStations}`;
                btnPrev.disabled = currentIndex === 0;
                btnNext.disabled = currentIndex === totalStations - 1;

                if (activeVinyl) {
                    returnVinyl(activeVinyl);
                }
            }

            btnNext.addEventListener('click', () => { if (currentIndex < totalStations - 1) { currentIndex++; updateCarousel(); } });
            btnPrev.addEventListener('click', () => { if (currentIndex > 0) { currentIndex--; updateCarousel(); } });
            updateCarousel(); 


            // --- LÓGICA DE VINILOS ---
            const vinylData = new Map();

            sleeves.forEach(sleeve => {
                const vinyl = sleeve.querySelector('.vinyl-wrapper') as HTMLElement;
                const cover = sleeve.querySelector('.album-cover') as HTMLElement;
                
                const station = sleeve.closest('.station') as HTMLElement;
                const dropzone = station.querySelector('.dropzone') as HTMLElement;
                const tonearm = station.querySelector('.tonearm') as HTMLElement;
                const projectHud = station.querySelector('.project-hud') as HTMLElement;
                const projectTitle = station.querySelector('.project-title') as HTMLElement;

                if (!vinyl || !cover || !dropzone || !tonearm) return;
                
                const peekX = parseInt(sleeve.getAttribute('data-peek') || '35', 10);
                const slideX = parseInt(sleeve.getAttribute('data-slide') || '160', 10);
                const titleText = sleeve.getAttribute('data-title') || 'Proyecto';
                const videoSrc = sleeve.getAttribute('data-video') || null;

                vinylData.set(vinyl, {
                    x: peekX, y: 0, state: 'sheathed', title: titleText, homeX: slideX, peekX: peekX, video: videoSrc,
                    dropzone, tonearm, projectHud, projectTitle
                });

                vinyl.style.transform = `translate(${peekX}px, 0px)`;

                cover.addEventListener('click', () => {
                    const data = vinylData.get(vinyl);
                    if (!data) return;
                    if (data.state === 'sheathed') { data.x = data.homeX; data.state = 'unsheathed'; } 
                    else if (data.state === 'unsheathed') { data.x = data.peekX; data.state = 'sheathed'; }
                    vinyl.style.transition = 'transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.2)';
                    vinyl.style.transform = `translate(${data.x}px, ${data.y}px)`;
                });

                let isDragging = false; let lastMouseX = 0; let lastMouseY = 0;

                vinyl.addEventListener('pointerdown', (e) => {
                    const data = vinylData.get(vinyl);
                    if (!data) return;
                    if (data.state === 'sheathed') data.state = 'unsheathed';

                    e.preventDefault(); isDragging = true;
                    lastMouseX = e.clientX; lastMouseY = e.clientY;
                    
                    vinyl.classList.add('dragging');
                    vinyl.style.transition = 'none';
                    
                    if (data.state === 'playing') {
                        vinyl.classList.remove('playing');
                        hideProjectInfo(data); stopMedia();
                        activeVinyl = null;
                        body.classList.remove('video-active');
                    }
                });

                const onPointerMove = (e) => {
                    if (!isDragging) return;
                    
                    const currentScale = body.classList.contains('video-active') ? 0.9 : 1;
                    const deltaX = (e.clientX - lastMouseX) / currentScale;
                    const deltaY = (e.clientY - lastMouseY) / currentScale;
                    
                    const data = vinylData.get(vinyl);
                    if (!data) return;

                    data.x += deltaX; data.y += deltaY;
                    vinyl.style.transform = `translate(${data.x}px, ${data.y}px)`;
                    
                    lastMouseX = e.clientX; lastMouseY = e.clientY;

                    if (isOverDropzone(vinyl, data.dropzone)) {
                        data.dropzone.classList.add('active-hover');
                    } else {
                        data.dropzone.classList.remove('active-hover');
                    }
                };

                const onPointerUp = () => {
                    if (!isDragging) return;
                    isDragging = false; vinyl.classList.remove('dragging');
                    const data = vinylData.get(vinyl);
                    if(!data) return;

                    data.dropzone.classList.remove('active-hover');

                    if (isOverDropzone(vinyl, data.dropzone)) {
                        if (activeVinyl && activeVinyl !== vinyl) returnVinyl(activeVinyl as HTMLElement);
                        snapToTurntable(vinyl, data); activeVinyl = vinyl;
                    } else {
                        returnVinyl(vinyl);
                    }
                };

                window.addEventListener('pointermove', onPointerMove);
                window.addEventListener('pointerup', onPointerUp);
                document.addEventListener('astro:before-swap', () => { window.removeEventListener('pointermove', onPointerMove); window.removeEventListener('pointerup', onPointerUp); }, { once: true });
            });

            // --- FUNCIONES DE FÍSICAS REFACTORIZADAS ---

            function isOverDropzone(vinyl: HTMLElement, dropzone: HTMLElement) {
                const vRect = vinyl.getBoundingClientRect(); const dRect = dropzone.getBoundingClientRect();
                const vCenterX = vRect.left + vRect.width / 2; const vCenterY = vRect.top + vRect.height / 2;
                const dCenterX = dRect.left + dRect.width / 2; const dCenterY = dRect.top + dRect.height / 2;
                return Math.hypot(vCenterX - dCenterX, vCenterY - dCenterY) < 130; 
            }

            function snapToTurntable(vinyl: HTMLElement, data: any) {
                const vRect = vinyl.getBoundingClientRect(); const dRect = data.dropzone.getBoundingClientRect();
                const currentScale = body.classList.contains('video-active') ? 0.9 : 1;
                const diffX = ((dRect.left + dRect.width / 2) - (vRect.left + vRect.width / 2)) / currentScale;
                const diffY = ((dRect.top + dRect.height / 2) - (vRect.top + vRect.height / 2)) / currentScale;

                data.x += diffX; data.y += diffY; data.state = 'playing';

                vinyl.style.zIndex = '30';
                vinyl.style.transition = 'transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.2)';
                vinyl.style.transform = `translate(${data.x}px, ${data.y}px)`;
                vinyl.classList.add('playing');
                
                data.tonearm.classList.add('tonearm-active');
                if (data.projectTitle) data.projectTitle.textContent = data.title;
                if (data.projectHud) { data.projectHud.style.opacity = '1'; data.projectHud.style.pointerEvents = 'auto'; }

                playMedia(data);
            }

            function returnVinyl(vinyl: HTMLElement) {
                const data = vinylData.get(vinyl); if (!data) return;

                data.x = data.peekX; data.y = 0; data.state = 'sheathed';
                vinyl.style.zIndex = '10'; 
                vinyl.style.transition = 'transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.2)';
                vinyl.style.transform = `translate(${data.x}px, ${data.y}px)`;
                vinyl.classList.remove('playing');

                if (activeVinyl === vinyl) {
                    hideProjectInfo(data); stopMedia(); activeVinyl = null;
                    body.classList.remove('video-active');
                }
            }

            function hideProjectInfo(data: any) {
                if (data.tonearm) data.tonearm.classList.remove('tonearm-active');
                if (data.projectHud) { data.projectHud.style.opacity = '0'; data.projectHud.style.pointerEvents = 'none'; }
            }

            function playMedia(data: any) {
                if (audioPlayer) audioPlayer.play().catch(() => {});
                if (data.video && videoPlayer) {
                    body.classList.add('video-active');
                    videoPlayer.src = data.video; videoPlayer.play().catch(() => {});
                } else {
                    body.classList.remove('video-active');
                }
            }

            function stopMedia() {
                if (audioPlayer) audioPlayer.pause();
                if (videoPlayer) { videoPlayer.pause(); videoPlayer.src = ""; }
            }
        });
    </script>
</body>
</html>