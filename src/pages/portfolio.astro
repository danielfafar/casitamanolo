---
// src/pages/portfolio.astro
import { ClientRouter } from 'astro:transitions';
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Casita Manolo | Archivo Musical</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <ClientRouter />
    
    <style>
        /* ========================================================
           1. RESET & VARIABLES
           ======================================================== */
        :root {
            --bg-color: #11231E; 
            --text-color: #F4F1EC; 
            --accent-color: #D74F42; 
            --ease-spring: cubic-bezier(0.175, 0.885, 0.32, 1.2);
            --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body, html {
            width: 100%;
            height: 100%;
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: 'Space Mono', monospace;
            overflow: hidden;
            user-select: none;
        }

        /* ========================================================
           2. LAYOUT & UI SUPERIOR
           ======================================================== */
        .portfolio-main {
            position: relative;
            width: 100vw;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .header-ui {
            position: absolute;
            top: 40px;
            width: 100%;
            display: flex;
            justify-content: space-between;
            padding: 0 50px;
            pointer-events: none;
            z-index: 50;
        }

        .section-title {
            opacity: 0.3;
            font-size: 0.75rem;
            letter-spacing: 0.4em;
        }

        .btn-volver {
            pointer-events: auto;
            color: var(--text-color);
            text-decoration: none;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            transition: color 0.3s, transform 0.3s;
        }

        .btn-volver:hover {
            color: var(--accent-color);
            transform: translateX(-5px);
        }

        /* ========================================================
           3. EL MONITOR DE VÍDEO (Izquierda - Oculto por defecto)
           ======================================================== */
        .video-presentation {
            position: absolute;
            left: 5%;
            width: 45vw;
            aspect-ratio: 16/9;
            background-color: #08110e;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 30px 60px rgba(0,0,0,0.8);
            border: 1px solid rgba(244,241,236,0.1);
            
            /* Estado oculto */
            opacity: 0;
            pointer-events: none;
            transform: translateX(-50px) scale(0.95);
            transition: all 0.8s var(--ease-spring);
            z-index: 40;
        }

        .video-presentation video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.8;
        }

        /* Estado Activo: Se revela el vídeo */
        body.video-active .video-presentation {
            opacity: 1;
            transform: translateX(0) scale(1);
        }

        /* ========================================================
           4. JUKEBOX (Centro - Se mueve a la derecha si hay vídeo)
           ======================================================== */
        .jukebox-stage {
            width: 100%;
            max-width: 1100px;
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            gap: 40px;
            z-index: 10;
            
            /* Estado Central Default */
            transform: translateX(0) scale(1);
            transition: transform 0.8s var(--ease-spring);
        }

        /* Estado Activo: El mueble entero se aparta */
        body.video-active .jukebox-stage {
            /* Se desplaza a la derecha y se hace ligeramente más pequeño */
            transform: translateX(20vw) scale(0.9);
        }

        .rack {
            display: flex;
            flex-direction: column;
            gap: 50px;
            z-index: 20;
        }

        /* ========================================================
           5. DISCOS Y CARÁTULAS
           ======================================================== */
        .sleeve-container {
            position: relative;
            width: 160px;
            height: 160px;
        }

        .album-cover {
            position: absolute;
            inset: 0;
            z-index: 20;
            border-radius: 4px;
            background-size: cover;
            background-position: center;
            box-shadow: 0 15px 35px rgba(0,0,0,0.6);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            transition: transform 0.4s var(--ease-spring), box-shadow 0.4s ease;
            border: 1px solid rgba(244,241,236,0.1);
        }

        .cover-text {
            font-size: 1.1rem;
            font-weight: 700;
            letter-spacing: 0.2em;
            line-height: 1.4;
            color: var(--bg-color);
            background-color: rgba(244,241,236,0.7);
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            pointer-events: none;
        }

        .sleeve-container:hover .album-cover {
            transform: scale(1.05);
            box-shadow: 0 20px 40px rgba(0,0,0,0.8);
        }

        .vinyl-wrapper {
            position: absolute;
            top: 2px;
            left: 2px;
            width: 156px;
            height: 156px;
            z-index: 10;
            touch-action: none;
            cursor: grab;
        }

        .vinyl-wrapper.dragging {
            cursor: grabbing;
            z-index: 60 !important;
        }

        .vinyl-art {
            width: 100%;
            height: 100%;
            filter: drop-shadow(0 10px 15px rgba(0,0,0,0.5));
        }

        @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        .vinyl-wrapper.playing .vinyl-art { animation: spin 3s linear infinite; }

        /* ========================================================
           6. EL TOCADISCOS
           ======================================================== */
        .turntable-wrapper {
            position: relative;
            width: 400px;
            height: 400px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .turntable-base {
            position: absolute;
            inset: 0;
            background-color: #0d1b17;
            border-radius: 50%;
            box-shadow: inset 0 10px 30px rgba(0,0,0,0.8), 0 20px 40px rgba(0,0,0,0.5);
            border: 1px solid #1a332a;
        }

        .dropzone {
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background-color: #08110e;
            border: 2px solid #1a332a;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            transition: border-color 0.3s ease, background-color 0.3s ease;
            z-index: 10;
        }

        .platter-ring {
            position: absolute;
            border-radius: 50%;
            border: 1px solid rgba(244,241,236,0.03);
            pointer-events: none;
        }
        .platter-ring.r1 { width: 260px; height: 260px; }
        .platter-ring.r2 { width: 200px; height: 200px; }

        .dropzone-text {
            position: absolute;
            font-size: 0.65rem;
            letter-spacing: 0.3em;
            color: rgba(244,241,236,0.3);
            text-align: center;
            pointer-events: none;
            line-height: 1.5;
        }

        .spindle {
            width: 16px;
            height: 16px;
            background-color: #b0b8b5;
            border-radius: 50%;
            box-shadow: 0 4px 6px rgba(0,0,0,0.5);
            z-index: 0;
        }

        .tonearm {
            position: absolute;
            top: 20px;
            right: 20px;
            width: 110px;
            height: 180px;
            pointer-events: none;
            transition: transform 0.7s ease-in-out;
            transform-origin: top right;
            z-index: 40;
        }
        .tonearm-active { transform: rotate(28deg); }

        /* ========================================================
           7. HUD DEL PROYECTO
           ======================================================== */
        .project-hud {
            position: absolute;
            bottom: -90px;
            display: flex;
            flex-direction: column;
            align-items: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.7s ease;
            z-index: 50;
        }

        .playing-indicator {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }

        .red-dot {
            width: 8px;
            height: 8px;
            background-color: var(--accent-color);
            border-radius: 50%;
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.3; } 100% { opacity: 1; } }

        .playing-text {
            font-size: 0.6rem;
            letter-spacing: 0.3em;
            color: var(--accent-color);
        }

        .project-title {
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            text-align: center;
        }
    </style>
</head>
<body>

    <main class="portfolio-main">
        
        <!-- ==============================================
             EL MONITOR DE VÍDEO
             ============================================== -->
        <div class="video-presentation">
            <!-- Reproductor inmersivo (Silenciado por defecto en UI modernas) -->
            <video id="project-video" loop muted playsinline>
                <source src="" type="video/mp4" />
            </video>
        </div>

        <!-- Audio Global Placeholder -->
        <audio id="player-audio" loop>
            <source src="/sounds/placeholder.mp3" type="audio/mpeg" />
        </audio>

        <!-- Interfaz Superior -->
        <div class="header-ui">
            <div class="section-title">ARCHIVO MUSICAL</div>
            <a href="/" class="btn-volver">← VOLVER A CASA</a>
        </div>

        <!-- ==============================================
             ESCENARIO JUKEBOX (Móvil si hay vídeo)
             ============================================== -->
        <div class="jukebox-stage">
            
            <!-- RACK IZQUIERDO -->
            <div class="rack">
                
                <!-- PROYECTO 1 (Con Vídeo) -->
                <div class="sleeve-container" data-peek="35" data-slide="160" data-title="EL MADRILEÑO" data-video="/videos/interior.mp4">
                    <div class="vinyl-wrapper">
                        <svg viewBox="0 0 100 100" class="vinyl-art">
                            <circle cx="50" cy="50" r="48" fill="#0b1714" stroke="#223b33" stroke-width="0.5"/>
                            <circle cx="50" cy="50" r="38" stroke="#1a2e28" stroke-width="1" fill="none"/>
                            <circle cx="50" cy="50" r="28" stroke="#1a2e28" stroke-width="1" fill="none"/>
                            <circle cx="50" cy="50" r="16" fill="#D74F42"/>
                            <circle cx="50" cy="50" r="2" fill="#F4F1EC"/>
                        </svg>
                    </div>
                    <div class="album-cover" style="background-image: url('/images/placeholder-1.jpg');">
                        <span class="cover-text">01<br>MADRILEÑO</span>
                    </div>
                </div>

                <!-- PROYECTO 2 (Sin Vídeo, solo música) -->
                <div class="sleeve-container" data-peek="35" data-slide="160" data-title="GIRA 2024">
                    <div class="vinyl-wrapper">
                        <svg viewBox="0 0 100 100" class="vinyl-art">
                            <circle cx="50" cy="50" r="48" fill="#0b1714" stroke="#223b33" stroke-width="0.5"/>
                            <circle cx="50" cy="50" r="38" stroke="#1a2e28" stroke-width="1" fill="none"/>
                            <circle cx="50" cy="50" r="28" stroke="#1a2e28" stroke-width="1" fill="none"/>
                            <circle cx="50" cy="50" r="16" fill="#E8B059"/>
                            <circle cx="50" cy="50" r="2" fill="#F4F1EC"/>
                        </svg>
                    </div>
                    <div class="album-cover" style="background-color: #E8B059; background-image: url('/images/placeholder-2.jpg');">
                        <span class="cover-text" style="background-color: rgba(17,35,30,0.7); color: #F4F1EC;">02<br>GIRA</span>
                    </div>
                </div>
            </div>

            <!-- TOCADISCOS -->
            <div class="turntable-wrapper">
                <div class="turntable-base"></div>
                
                <div id="dropzone" class="dropzone">
                    <div class="platter-ring r1"></div>
                    <div class="platter-ring r2"></div>
                    <div class="dropzone-text">ARRASTRA<br>EL DISCO</div>
                    <div class="spindle"></div>
                </div>

                <svg id="tonearm" viewBox="0 0 100 100" class="tonearm">
                    <circle cx="80" cy="20" r="14" fill="#1a332a" stroke="#08110e" stroke-width="2"/>
                    <circle cx="80" cy="20" r="4" fill="#b0b8b5"/>
                    <path d="M 80 20 L 40 120 L 20 140" fill="none" stroke="#b0b8b5" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                    <rect x="11" y="130" width="18" height="30" fill="#2a3b35" rx="2" transform="rotate(45 20 140)"/>
                </svg>

                <div id="project-hud" class="project-hud">
                    <div class="playing-indicator">
                        <div class="red-dot"></div>
                        <span class="playing-text">REPRODUCIENDO</span>
                    </div>
                    <h2 id="project-title" class="project-title">Título</h2>
                </div>
            </div>

            <!-- RACK DERECHO -->
            <div class="rack">
                
                <!-- PROYECTO 3 -->
                <div class="sleeve-container" data-peek="-35" data-slide="-160" data-title="SESIONES VIVO">
                    <div class="vinyl-wrapper">
                        <svg viewBox="0 0 100 100" class="vinyl-art">
                            <circle cx="50" cy="50" r="48" fill="#0b1714" stroke="#223b33" stroke-width="0.5"/>
                            <circle cx="50" cy="50" r="38" stroke="#1a2e28" stroke-width="1" fill="none"/>
                            <circle cx="50" cy="50" r="28" stroke="#1a2e28" stroke-width="1" fill="none"/>
                            <circle cx="50" cy="50" r="16" fill="#5982e8"/>
                            <circle cx="50" cy="50" r="2" fill="#F4F1EC"/>
                        </svg>
                    </div>
                    <div class="album-cover" style="background-color: #5982e8; background-image: url('/images/placeholder-3.jpg');">
                        <span class="cover-text" style="background-color: rgba(17,35,30,0.7); color: #F4F1EC;">03<br>SESIONES</span>
                    </div>
                </div>

                <!-- PROYECTO 4 -->
                <div class="sleeve-container" data-peek="-35" data-slide="-160" data-title="VIDEOCLIPS">
                    <div class="vinyl-wrapper">
                        <svg viewBox="0 0 100 100" class="vinyl-art">
                            <circle cx="50" cy="50" r="48" fill="#0b1714" stroke="#223b33" stroke-width="0.5"/>
                            <circle cx="50" cy="50" r="38" stroke="#1a2e28" stroke-width="1" fill="none"/>
                            <circle cx="50" cy="50" r="28" stroke="#1a2e28" stroke-width="1" fill="none"/>
                            <circle cx="50" cy="50" r="16" fill="#738f66"/>
                            <circle cx="50" cy="50" r="2" fill="#F4F1EC"/>
                        </svg>
                    </div>
                    <div class="album-cover" style="background-color: #738f66; background-image: url('/images/placeholder-4.jpg');">
                        <span class="cover-text" style="background-color: rgba(17,35,30,0.7); color: #F4F1EC;">04<br>VIDEOS</span>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <script>
        document.addEventListener('astro:page-load', () => {
            const body = document.body;
            const sleeves = document.querySelectorAll('.sleeve-container');
            const dropzone = document.getElementById('dropzone');
            const tonearm = document.getElementById('tonearm');
            const projectHud = document.getElementById('project-hud');
            const projectTitle = document.getElementById('project-title');
            
            // Reproductores
            const audioPlayer = document.getElementById('player-audio') as HTMLAudioElement;
            const videoPlayer = document.getElementById('project-video') as HTMLVideoElement;

            if (!dropzone || !tonearm || !projectHud || !projectTitle) return;

            let activeVinyl = null; 
            const vinylData = new Map();

            sleeves.forEach(sleeve => {
                const vinyl = sleeve.querySelector('.vinyl-wrapper') as HTMLElement;
                const cover = sleeve.querySelector('.album-cover') as HTMLElement;
                if (!vinyl || !cover) return;
                
                const peekX = parseInt(sleeve.getAttribute('data-peek') || '35', 10);
                const slideX = parseInt(sleeve.getAttribute('data-slide') || '160', 10);
                const titleText = sleeve.getAttribute('data-title') || 'Proyecto';
                const videoSrc = sleeve.getAttribute('data-video') || null;

                vinylData.set(vinyl, {
                    x: peekX, 
                    y: 0, 
                    state: 'sheathed', 
                    title: titleText,
                    homeX: slideX,
                    peekX: peekX,
                    video: videoSrc
                });

                vinyl.style.transform = `translate(${peekX}px, 0px)`;

                // 1. DESENFUNDAR
                cover.addEventListener('click', () => {
                    const data = vinylData.get(vinyl);
                    if (!data) return;
                    
                    if (data.state === 'sheathed') {
                        data.x = data.homeX;
                        data.y = 0;
                        data.state = 'unsheathed';
                    } else if (data.state === 'unsheathed') {
                        data.x = data.peekX;
                        data.y = 0;
                        data.state = 'sheathed';
                    }

                    vinyl.style.transition = 'transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.2)';
                    vinyl.style.transform = `translate(${data.x}px, ${data.y}px)`;
                });

                // 2. ARRASTRE
                let isDragging = false;
                let lastMouseX = 0;
                let lastMouseY = 0;

                vinyl.addEventListener('pointerdown', (e) => {
                    const data = vinylData.get(vinyl);
                    if (!data) return;
                    
                    if (data.state === 'sheathed') {
                        data.state = 'unsheathed';
                    }

                    e.preventDefault();
                    isDragging = true;
                    lastMouseX = e.clientX;
                    lastMouseY = e.clientY;
                    
                    vinyl.classList.add('dragging');
                    vinyl.style.transition = 'none';
                    
                    // Si estaba sonando, lo quitamos de golpe y restauramos la cámara
                    if (data.state === 'playing') {
                        vinyl.classList.remove('playing');
                        hideProjectInfo();
                        stopMedia();
                        activeVinyl = null;
                        body.classList.remove('video-active');
                    }
                });

                const onPointerMove = (e) => {
                    if (!isDragging) return;
                    
                    // CÁLCULO SENIOR: Compensamos el CSS Scale (0.9) si la cámara está movida
                    const currentScale = body.classList.contains('video-active') ? 0.9 : 1;
                    
                    const deltaX = (e.clientX - lastMouseX) / currentScale;
                    const deltaY = (e.clientY - lastMouseY) / currentScale;
                    
                    const data = vinylData.get(vinyl);
                    if (!data) return;

                    data.x += deltaX;
                    data.y += deltaY;
                    
                    vinyl.style.transform = `translate(${data.x}px, ${data.y}px)`;
                    
                    lastMouseX = e.clientX;
                    lastMouseY = e.clientY;

                    if (isOverDropzone(vinyl)) {
                        dropzone.style.borderColor = '#D74F42';
                        dropzone.style.backgroundColor = '#15241f';
                    } else {
                        dropzone.style.borderColor = '#1a332a';
                        dropzone.style.backgroundColor = '#08110e';
                    }
                };

                const onPointerUp = () => {
                    if (!isDragging) return;
                    isDragging = false;
                    vinyl.classList.remove('dragging');
                    dropzone.style.borderColor = '#1a332a';
                    dropzone.style.backgroundColor = '#08110e';

                    if (isOverDropzone(vinyl)) {
                        if (activeVinyl && activeVinyl !== vinyl) {
                            returnVinyl(activeVinyl as HTMLElement);
                        }
                        snapToTurntable(vinyl);
                        activeVinyl = vinyl;
                    } else {
                        returnVinyl(vinyl);
                    }
                };

                window.addEventListener('pointermove', onPointerMove);
                window.addEventListener('pointerup', onPointerUp);
                
                document.addEventListener('astro:before-swap', () => {
                    window.removeEventListener('pointermove', onPointerMove);
                    window.removeEventListener('pointerup', onPointerUp);
                }, { once: true });
            });

            // --- LÓGICA DE FÍSICAS Y MEDIA ---

            function isOverDropzone(vinyl: HTMLElement) {
                const vRect = vinyl.getBoundingClientRect();
                const dRect = dropzone.getBoundingClientRect();
                const vCenterX = vRect.left + vRect.width / 2;
                const vCenterY = vRect.top + vRect.height / 2;
                const dCenterX = dRect.left + dRect.width / 2;
                const dCenterY = dRect.top + dRect.height / 2;
                const distance = Math.hypot(vCenterX - dCenterX, vCenterY - dCenterY);
                return distance < 130; 
            }

            function snapToTurntable(vinyl: HTMLElement) {
                const vRect = vinyl.getBoundingClientRect();
                const dRect = dropzone.getBoundingClientRect();
                
                // Calculamos la distancia exacta sin importar si el div está escalado
                const currentScale = body.classList.contains('video-active') ? 0.9 : 1;
                const diffX = ((dRect.left + dRect.width / 2) - (vRect.left + vRect.width / 2)) / currentScale;
                const diffY = ((dRect.top + dRect.height / 2) - (vRect.top + vRect.height / 2)) / currentScale;

                const data = vinylData.get(vinyl);
                if (!data) return;

                data.x += diffX;
                data.y += diffY;
                data.state = 'playing';

                vinyl.style.zIndex = '30';
                vinyl.style.transition = 'transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.2)';
                vinyl.style.transform = `translate(${data.x}px, ${data.y}px)`;
                vinyl.classList.add('playing');
                
                tonearm.classList.add('tonearm-active');
                if (projectTitle) projectTitle.textContent = data.title;
                if (projectHud) {
                    projectHud.style.opacity = '1';
                    projectHud.style.pointerEvents = 'auto';
                }

                playMedia(data);
            }

            function returnVinyl(vinyl: HTMLElement) {
                const data = vinylData.get(vinyl);
                if (!data) return;

                data.x = data.peekX; 
                data.y = 0;
                data.state = 'sheathed';

                vinyl.style.zIndex = '10'; 
                vinyl.style.transition = 'transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.2)';
                vinyl.style.transform = `translate(${data.x}px, ${data.y}px)`;
                vinyl.classList.remove('playing');

                if (activeVinyl === vinyl) {
                    hideProjectInfo();
                    stopMedia();
                    activeVinyl = null;
                    body.classList.remove('video-active');
                }
            }

            function hideProjectInfo() {
                if (tonearm) tonearm.classList.remove('tonearm-active');
                if (projectHud) {
                    projectHud.style.opacity = '0';
                    projectHud.style.pointerEvents = 'none';
                }
            }

            function playMedia(data: any) {
                // Siempre reproducimos el audio ambiente
                if (audioPlayer) {
                    audioPlayer.play().catch(() => {});
                }

                // Si el disco tiene vídeo asignado, movemos la cámara y lo cargamos
                if (data.video && videoPlayer) {
                    body.classList.add('video-active');
                    videoPlayer.src = data.video;
                    videoPlayer.play().catch(() => {});
                } else {
                    body.classList.remove('video-active');
                }
            }

            function stopMedia() {
                if (audioPlayer) audioPlayer.pause();
                if (videoPlayer) {
                    videoPlayer.pause();
                    videoPlayer.src = ""; // Limpiamos la caché
                }
            }
        });
    </script>
</body>
</html>