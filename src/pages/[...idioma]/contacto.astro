---
// src/pages/contacto.astro
import Layout from '../../layouts/Layout.astro';
import { rutasDeIdioma, enlace, t, type Idioma } from '../../i18n/config';
import { textos } from '../../i18n/textos';
import Tiradores from '../../components/Tiradores.astro';

export function getStaticPaths() { return rutasDeIdioma(); }
const { idioma } = Astro.props as { idioma: Idioma };
const T = textos[idioma];
---

<Layout title={T.contacto.titulo} idioma={idioma} destino="/contacto">
    
    <main class="printer-room">
        
        <!-- Botón Volver -->
        <a href={enlace('/', idioma)} class="btn-volver">
            {T.comun.volverCasa}
        </a>

        <Tiradores idioma={idioma} destino="/contacto" />

        <!-- La ranura de la impresora por donde sale el ticket -->
        <div class="printer-slot"></div>

        <div class="ticket-wrapper">
            <article class="ticket">
                
                <!-- Encabezado del Local -->
                <header class="ticket-header">
                    <h1>{T.contacto.casa}</h1>
                    <p>{T.contacto.sede}</p>
                    <p>{T.contacto.direccion}</p>
                    <p>{T.contacto.nif}</p>
                </header>

                <!-- Metadatos (Generados dinámicamente) -->
                <div class="ticket-meta">
                    <div class="row"><span>{T.contacto.mesa}</span> <span>04</span></div>
                    <div class="row"><span>{T.contacto.fecha}</span> <span id="current-date">--/--/----</span></div>
                    <div class="row"><span>{T.contacto.hora}</span> <span id="current-time">--:--</span></div>
                    <div class="row"><span>{T.contacto.atendio}</span> <span>{T.contacto.camarero}</span></div>
                </div>

                <div class="divider"></div>

                <!-- El "Manifiesto" disfrazado de comanda -->
                <div class="ticket-items">
                    <div class="row font-bold mb-2"><span>{T.contacto.descripcion}</span> <span>{T.contacto.importe}</span></div>
                    <div class="row"><span>{T.contacto.items.briefing}</span> <span>0.00</span></div>
                    <div class="row"><span>{T.contacto.items.escucha}</span> <span>0.00</span></div>
                    <div class="row"><span>{T.contacto.items.tema}</span> <span>{T.contacto.invitacion}</span></div>
                    <div class="row"><span>{T.contacto.items.revisiones}</span> <span>{T.contacto.invitacion}</span></div>
                    <div class="row"><span>{T.contacto.items.mezcla}</span> <span>{T.contacto.invitacion}</span></div>
                </div>

                <div class="divider"></div>
                <div class="divider"></div>

                <!-- Formulario integrado en el ticket -->
                <div class="ticket-form-section">
                    <p class="form-instructions">{T.contacto.rellenar}</p>
                    
                    <form id="contact-form" class="ticket-form" action="https://formsubmit.co/infocasitamanolo@gmail.com" method="POST" data-astro-reload>
                        <input type="hidden" name="_subject" value={T.contacto.asunto} />
                        <input type="hidden" name="_template" value="table" />
                        <input type="hidden" name="Fecha_UTC" id="submission-date" value="" />
                        <div class="form-row">
                            <label for="name">{T.contacto.nombre}</label>
                            <input type="text" id="name" name="nombre" required autocomplete="name" maxlength="150" />
                        </div>
                        
                        <div class="form-row">
                            <label for="email">{T.contacto.email}</label>
                            <input type="email" id="email" name="email" required autocomplete="email" maxlength="254" />
                        </div>
                        
                        <div class="form-row-col">
                            <label for="message">{T.contacto.encargo}</label>
                            <textarea id="message" name="encargo" rows="3" required maxlength="10000"></textarea>
                        </div>

                        <!-- El Botón es un Sello de Caucho Rojo -->
                        <div class="stamp-container">
                            <button
                                type="submit"
                                class="stamp-btn"
                                id="submit-btn"
                                data-enviar={T.contacto.enviar}
                                data-enviando={T.contacto.enviando}
                                data-aviso={T.contacto.aviso}
                            >
                                {T.contacto.enviar}
                            </button>
                        </div>
                    </form>
                    <p class="contact-direct">{T.contacto.tambien} <a href="mailto:infocasitamanolo@gmail.com">infocasitamanolo@gmail.com</a>.</p>
                </div>

                <div class="divider"></div>

                <!-- Pie del Ticket limpio -->
                <footer class="ticket-footer">
                    <p class="total">{T.contacto.total}</p>
                    <p class="thank-you">{T.contacto.gracias}</p>
                    <p class="thank-you">{T.contacto.web}</p>
                    <a href={enlace('/', idioma)} class="ticket-salida">{T.comun.volverCasita}</a>
                </footer>

            </article>
        </div>

        <!-- Only the provider can confirm a submission; do not simulate success. -->
        <div id="system-toast" class="system-toast" role="status" aria-live="polite"></div>

    </main>
</Layout>

<style>
    /* ========================================================
       1. VARIABLES Y ESTRUCTURA BASE
       ======================================================== */
    :root {
        --ink-dark: #11231E; 
        --paper-light: #F4F1EC; 
        --accent-red: #D74F42; 
        --thermal-blur: 0px 0px 1px rgba(17, 35, 30, 0.4);
        --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body, html {
        width: 100%;
        height: 100%;
        background-color: var(--ink-dark);
        font-family: 'Space Mono', monospace;
    }

    .printer-room {
        position: relative;
        width: 100%;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* El ticket sale un poco mas abajo: arriba estan los grifos */
        padding: 150px 20px 60px;
        overflow-y: auto;
        overflow-x: hidden;
    }

    /* Botón Volver. Va fijo sobre el ticket, que es blanco y ocupa el
       centro de la pantalla: sin chapa propia el texto desaparecía. */
    .btn-volver {
        position: fixed;
        top: 24px;
        left: 24px;
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 10px 18px;
        border-radius: 999px;
        background: rgba(8, 17, 14, 0.92);
        border: 1px solid rgba(244, 241, 236, 0.35);
        color: var(--paper-light);
        text-decoration: none;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        transition: background-color 0.3s, color 0.3s, transform 0.3s;
        z-index: 100;
    }

    .btn-volver:hover, .btn-volver:focus-visible {
        background: var(--accent-red);
        color: var(--paper-light);
        transform: translateX(-4px);
    }

    /* Y otra salida al final del ticket, para quien llega abajo del todo */
    .ticket-salida {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        margin-top: 18px;
        padding: 10px 16px;
        border: 1px dashed rgba(17, 35, 30, 0.45);
        color: var(--ink-dark);
        text-decoration: none;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.14em;
    }
    .ticket-salida:hover, .ticket-salida:focus-visible {
        border-style: solid;
        color: var(--accent-red);
        border-color: var(--accent-red);
    }

    /* ========================================================
       2. EL TICKET TÉRMICO
       ======================================================== */
    .printer-slot {
        position: absolute;
        top: 90px;
        width: 380px;
        height: 20px;
        background: #08110e;
        border-radius: 0 0 10px 10px;
        box-shadow: inset 0 10px 20px rgba(0,0,0,1);
        z-index: 50;
    }

    .ticket-wrapper {
        perspective: 1000px;
        margin-top: -60px;
    }

    .ticket {
        position: relative;
        width: 360px;
        background-color: var(--paper-light);
        color: var(--ink-dark);
        padding: 40px 30px;
        box-shadow: 0 30px 60px rgba(0,0,0,0.5);
        text-shadow: var(--thermal-blur);
        animation: printOut 1.5s var(--ease-out) forwards;
        transform-origin: top center;
    }

    @keyframes printOut {
        0% { transform: translateY(-100%) rotateX(-10deg); opacity: 0; }
        100% { transform: translateY(20px) rotateX(0deg); opacity: 1; }
    }

    /* BORDES ZIG-ZAG */
    .ticket::before,
    .ticket::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        height: 6px;
        background-size: 12px 100%;
    }

    .ticket::before {
        top: -6px;
        background-image: linear-gradient(135deg, var(--paper-light) 50%, transparent 50%),
                          linear-gradient(-135deg, var(--paper-light) 50%, transparent 50%);
        background-position: top left;
    }

    .ticket::after {
        bottom: -6px;
        background-image: linear-gradient(45deg, var(--paper-light) 50%, transparent 50%),
                          linear-gradient(-45deg, var(--paper-light) 50%, transparent 50%);
        background-position: bottom left;
    }

    /* ========================================================
       3. CONTENIDO DEL TICKET
       ======================================================== */
    .ticket-header {
        text-align: center;
        margin-bottom: 20px;
    }

    .ticket-header h1 {
        font-size: 1.8rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        line-height: 1.1;
        margin-bottom: 5px;
    }

    .ticket-header p {
        font-size: 0.75rem;
        line-height: 1.4;
    }

    .divider {
        border-top: 2px dashed var(--ink-dark);
        width: 100%;
        margin: 15px 0;
        opacity: 0.6;
    }

    .row {
        display: flex;
        justify-content: space-between;
        font-size: 0.8rem;
        line-height: 1.6;
    }

    .font-bold { font-weight: 700; }
    .mb-2 { margin-bottom: 8px; }

    /* ========================================================
       4. FORMULARIO INTEGRADO
       ======================================================== */
    .form-instructions {
        font-size: 0.75rem;
        font-weight: 700;
        margin-bottom: 15px;
        text-align: center;
    }

    .ticket-form {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .form-row {
        display: flex;
        align-items: flex-end;
        gap: 10px;
    }

    .form-row-col {
        display: flex;
        flex-direction: column;
        gap: 5px;
        margin-top: 5px;
    }

    .ticket-form label {
        font-size: 0.85rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .ticket-form input,
    .ticket-form textarea {
        flex-grow: 1;
        background: transparent;
        border: none;
        border-bottom: 2px dotted var(--ink-dark);
        color: var(--ink-dark);
        font-family: 'Space Mono', monospace;
        font-size: 0.85rem;
        padding: 2px 0;
        outline: none;
        resize: none;
        text-shadow: var(--thermal-blur);
        transition: border-color 0.3s;
    }

    .ticket-form textarea {
        background-image: linear-gradient(transparent, transparent 23px, var(--ink-dark) 24px);
        background-size: 100% 24px;
        line-height: 24px;
        border-bottom: none;
        padding-top: 0;
    }

    .ticket-form input:focus,
    .ticket-form textarea:focus {
        border-bottom-color: var(--accent-red);
    }

    /* EL SELLO (Botón Submit) */
    .stamp-container {
        display: flex;
        justify-content: center;
        margin-top: 30px;
        margin-bottom: 10px;
    }

    .stamp-btn {
        background: transparent;
        border: 3px solid var(--accent-red);
        color: var(--accent-red);
        font-family: 'Space Mono', monospace;
        font-size: 1.1rem;
        font-weight: 700;
        padding: 10px 20px;
        border-radius: 4px;
        cursor: pointer;
        transform: rotate(-4deg);
        opacity: 0.8;
        transition: transform 0.1s, opacity 0.3s;
        text-shadow: none; 
    }

    .stamp-btn:hover {
        opacity: 1;
        transform: scale(1.05) rotate(-6deg);
    }

    .stamp-btn:active {
        transform: scale(0.95) rotate(-2deg);
    }

    .stamp-btn:disabled { opacity: 0.5; cursor: wait; }
    .contact-direct { margin-top: 20px; font-size: 0.8rem; line-height: 1.7; text-align: center; overflow-wrap: anywhere; }
    .contact-direct a { color: inherit; text-underline-offset: 3px; }

    /* ========================================================
       5. PIE DEL TICKET
       ======================================================== */
    .ticket-footer {
        text-align: center;
        margin-top: 15px;
    }

    .total {
        font-size: 1.2rem;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .thank-you {
        font-size: 0.75rem;
        opacity: 0.7;
    }

    /* ========================================================
       6. SISTEMA DE NOTIFICACIÓN
       ======================================================== */
    .system-toast {
        position: fixed;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%) translateY(20px);
        background: #08110e;
        color: #4ade80; 
        padding: 10px 20px;
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        border: 1px solid #1a332a;
        opacity: 0;
        pointer-events: none;
        transition: all 0.4s var(--ease-out);
        z-index: 100;
        max-width: calc(100vw - 32px);
        text-align: center;
    }

    .system-toast.active {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
    }

    /* En el móvil el ticket ocupa el ancho entero: el botón se queda arriba
       a la izquierda y el papel sale un poco más abajo de la ranura para que
       no le tape la cabecera. */
    @media (max-width: 680px) {
        /* En el movil los grifos van abajo, asi que el ticket recupera su sitio */
        .printer-room { padding-top: 60px; }
        .printer-slot { top: 0; }

        .btn-volver {
            top: 16px;
            left: 16px;
            padding: 10px 14px;
            font-size: 0.64rem;
            letter-spacing: 0.14em;
        }

        .ticket-wrapper { margin-top: -6px; }
    }
</style>

<script>
    document.addEventListener('astro:page-load', () => {
        const dateElement = document.getElementById('current-date');
        const timeElement = document.getElementById('current-time');
        
        if (dateElement && timeElement) {
            const now = new Date();
            const local = document.documentElement.lang || 'es';
            dateElement.textContent = now.toLocaleDateString(local, { day: '2-digit', month: '2-digit', year: 'numeric' });
            timeElement.textContent = now.toLocaleTimeString(local, { hour: '2-digit', minute: '2-digit' });
        }

        const form = document.getElementById('contact-form') as HTMLFormElement;
        const toast = document.getElementById('system-toast');
        const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
        const submissionDate = document.getElementById('submission-date') as HTMLInputElement | null;

        if (form && toast && submitBtn) {
            const lifetime = new AbortController();
            const options = { signal: lifetime.signal };
            const resetSubmit = () => {
                submitBtn.disabled = false;
                submitBtn.textContent = submitBtn.dataset.enviar ?? '';
                toast.classList.remove('active');
                toast.textContent = '';
            };
            resetSubmit();
            form.addEventListener('submit', (event) => {
                if (submitBtn.disabled) { event.preventDefault(); return; }
                if (submissionDate) submissionDate.value = new Date().toISOString();
                submitBtn.disabled = true;
                submitBtn.textContent = submitBtn.dataset.enviando ?? '';
                toast.textContent = submitBtn.dataset.aviso ?? '';
                toast.classList.add('active');
                // Native POST works without JavaScript, keeps FormSubmit's CAPTCHA,
                // and lets the provider handle activation, errors and confirmation.
                // Keep the user's fields intact when returning to this page.
            }, options);
            window.addEventListener('pageshow', resetSubmit, options);
            document.addEventListener('astro:before-swap', () => lifetime.abort(), { once: true, signal: lifetime.signal });
        }
    });
</script>
