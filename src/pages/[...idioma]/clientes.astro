---
import Layout from '../../layouts/Layout.astro';
import { clients } from '../../data/clients';
import { rutasDeIdioma, enlace, t, type Idioma } from '../../i18n/config';
import { textos } from '../../i18n/textos';
import Tiradores from '../../components/Tiradores.astro';

export function getStaticPaths() { return rutasDeIdioma(); }
const { idioma } = Astro.props as { idioma: Idioma };
const T = textos[idioma];
---
<Layout title={T.clientes.titulo} idioma={idioma} destino="/clientes">
  <main class="bar-counter">
    <header class="header-ui">
      <a class="btn-volver" href={enlace('/', idioma)}>{T.comun.volverCasa}</a>
      <div class="coaster-heading"><h1>{T.clientes.cabecera}</h1><p>{T.clientes.subtitulo}</p></div>
      <button class="tidy-button" type="button" id="tidy-coasters">{T.clientes.ordenar}</button>
    </header>
    <div id="physics-world" class="coaster-world" aria-label={T.clientes.posavasos} data-abrir-ficha={T.clientes.abrirFichaDe} style={`--filas-3:${Math.ceil(clients.length / 3)}; --filas-2:${Math.ceil(clients.length / 2)}`}>
      {clients.map((client, index) => (
        <button type="button" class="coaster-wrapper" data-client={client.id} style={`--tilt:${[-9, 8, -5, 12, -7, 5][index % 6]}deg`} aria-label={`${T.clientes.girar} ${client.name}`} aria-controls={`project-${client.id}`}>
          <span class="coaster-body">
            <span class={`coaster-face coaster-front c-${client.surface}`}>
              {client.logo
                ? <span class="coaster-logo con-imagen"><img src={client.logo} alt={client.name} loading="lazy" /><span>{t(client.category, idioma)}</span></span>
                : <span class:list={["coaster-logo", { largo: client.name.length > 11 }]}>{client.name}<span>{t(client.category, idioma)}</span></span>}
            </span>
            <span class="coaster-face coaster-back" aria-hidden="true"><span class="back-category">{t(client.category, idioma)}</span><span class="back-title">{client.project ? t(client.project.title, idioma) : client.name}</span><span class="back-action">{T.clientes.abrirFicha}</span></span>
          </span>
        </button>
      ))}
    </div>
    <p class="table-note">{T.clientes.nota}</p>

    <Tiradores idioma={idioma} destino="/clientes" />
  </main>
  {clients.map(client => (
    <dialog id={`project-${client.id}`} class="project-dialog" aria-labelledby={`title-${client.id}`}>
      <form method="dialog" class="dialog-top"><span>{t(client.category, idioma)}</span><button class="dialog-close" aria-label={T.clientes.cerrarFicha}>✕</button></form>
      <p class="project-brand">{client.name}</p>
      <h2 id={`title-${client.id}`}>{client.project ? t(client.project.title, idioma) : T.clientes.sinFicha}</h2>
      {client.project ? <>
        {client.project.year && <p>{client.project.year}</p>}
        <p><strong>{T.clientes.participacion}</strong> {t(client.project.role, idioma)}</p><p>{t(client.project.summary, idioma)}</p>
        {client.project.audio && <audio controls preload="none" src={client.project.audio} aria-label={`${T.clientes.escuchar} ${t(client.project.title, idioma)}`}></audio>}
        {client.project.video && <video controls playsinline preload="none" poster={client.project.poster} src={client.project.video} aria-label={`${T.clientes.ver} ${t(client.project.title, idioma)}`}></video>}
      </> : <p class="pending-case">{T.clientes.pendiente}</p>}
      <div class="dialog-actions"><a href={enlace('/portfolio', idioma)}>{T.clientes.irArchivo}</a><button type="button" data-turn-back={client.id}>{T.clientes.volverGirar}</button></div>
    </dialog>
  ))}
</Layout>
<style>
  .bar-counter { min-height: 100svh; padding: 28px clamp(18px, 4vw, 60px) 16px; color: #f4f1ec; background: repeating-linear-gradient(90deg, #00000010 0 1px, transparent 1px 44px), #361f10; box-shadow: inset 0 0 100px #00000070; font-family: 'Space Mono', monospace; box-sizing: border-box; }
  .bar-counter *, .project-dialog * { box-sizing: border-box; }
  .header-ui { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; flex-wrap: wrap; max-width: 1200px; margin: auto; }
  .btn-volver { display: inline-flex; align-items: center; min-height: 44px; color: #f4f1ec; font-size: 14px; text-decoration: none; }
  .coaster-heading { flex: 1; min-width: min(280px, 100%); }
  .coaster-heading h1 { font-family: 'Architects Daughter', cursive; font-size: clamp(1.8rem, 4vw, 2.7rem); font-weight: 400; margin: 0 0 8px; }
  .coaster-heading p { font-size: 14px; line-height: 1.7; margin: 0; color: #e0d2c2; max-width: 44ch; }
  .tidy-button { font: inherit; font-size: 14px; min-height: 44px; color: #f4f1ec; background: transparent; border: 1px solid #b6a492; padding: 10px 14px; cursor: pointer; border-radius: 4px; }
  .coaster-world { position: relative; min-height: max(520px, calc(var(--filas-3) * 214px)); max-width: 1100px; margin: 16px auto 0; display: grid; grid-template-columns: repeat(3, 1fr); place-items: center; gap: 32px; padding: 28px; }
  .coaster-wrapper { appearance: none; padding: 0; border: 0; background: none; color: inherit; position: relative; width: 180px; height: 180px; cursor: grab; touch-action: pan-y; perspective: 900px; transform: rotate(var(--tilt)); }
  .coaster-world.is-interactive .coaster-wrapper { position: absolute; left: 0; top: 0; touch-action: none; }
  .coaster-wrapper.is-dragging { cursor: grabbing; z-index: 50; }
  .coaster-wrapper.is-dealing { transition: transform .45s ease; }
  .coaster-body { position: relative; display: block; width: 100%; height: 100%; transform-style: preserve-3d; transition: transform .55s cubic-bezier(.2,.7,.3,1); }
  .coaster-wrapper.is-flipped .coaster-body { transform: rotateY(180deg); }
  .coaster-face { position: absolute; inset: 0; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 22px; box-shadow: -2px 5px 10px #00000070, inset 0 0 0 7px #00000008; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .coaster-back { transform: rotateY(180deg); background: #e6cfaa; color: #30271d; gap: 10px; font-family: 'Space Mono', monospace; }
  .coaster-logo { font: 700 24px/1.1 Arial, sans-serif; text-align: center; }
  .coaster-logo > span { display: block; font-family: 'Space Mono', monospace; font-size: 12px; margin-top: 9px; font-weight: 400; line-height: 1.4; }
  .back-category { font-size: 12px; line-height: 1.3; }
  .back-title { font-size: 16px; line-height: 1.4; font-weight: 700; }
  .back-action { font-size: 14px; text-decoration: underline; text-underline-offset: 4px; }
  .c-white { background: #f4f4f0; color: #17261f; }
  .c-black { background: #252924; color: #f4f4f0; }
  .c-kraft { background: #d2b48c; color: #3e2723; }
  .coaster-logo.largo { font-size: 19px; }
  /* Las marcas de las que tenemos logo lo llevan impreso; el resto, su nombre */
  .coaster-logo.con-imagen { display: flex; flex-direction: column; align-items: center; }
  .coaster-logo.con-imagen img { display: block; width: 104px; max-height: 58px; object-fit: contain; }
  [data-client='movistar'] .coaster-logo { color: #019df4; }
  [data-client='airbnb'] .coaster-logo { color: #ff385c; }
  [data-client='icex'] .coaster-logo { color: #e8b059; }
  [data-client='freixenet'] .coaster-logo { color: #c9a24a; font-family: Georgia, serif; }
  [data-client='skoda'] .coaster-logo { color: #1f5f2a; }
  [data-client='seleccion-espanola'] .coaster-logo { color: #a8111c; }
  [data-client='casa-tarradellas'] .coaster-logo { color: #c8341f; }
  [data-client='adolfo-dominguez'] .coaster-logo { font-family: Georgia, serif; font-weight: 400; }
  [data-client='junta-andalucia'] .coaster-logo { color: #007a33; }
  [data-client='dia'] .coaster-logo { color: #c8101c; }
  [data-client='eroski'] .coaster-logo { color: #d6001c; }
  [data-client='ministerio-cultura'] .coaster-logo { font-family: Georgia, serif; font-weight: 400; }
  .table-note { text-align: center; color: #e0d2c2; font-size: 14px; }
  .bar-counter button:focus-visible, .bar-counter a:focus-visible { outline: 3px solid #e8b059; outline-offset: 7px; }
  .project-dialog { box-sizing: border-box; color: #11231e; background: #f4f1ec; font-family: 'Space Mono', monospace; width: min(560px, calc(100% - 32px)); max-height: 85svh; padding: clamp(22px, 5vw, 38px); border: 2px solid #11231e; border-radius: 6px 10px 7px 12px; box-shadow: 10px 10px 0 #00000040; }
  .project-dialog::backdrop { background: #08110ecf; }
  .dialog-top { display: flex; align-items: center; justify-content: space-between; gap: 20px; font-size: 14px; }
  .dialog-close { font: inherit; border: 1px solid #11231e; border-radius: 50%; width: 44px; height: 44px; background: none; cursor: pointer; }
  .project-brand { font-size: 13px; letter-spacing: .12em; margin: 24px 0 12px; }
  .project-dialog h2 { font-family: 'Architects Daughter', cursive; font-size: 32px; line-height: 1.25; font-weight: 400; }
  .project-dialog p { line-height: 1.8; }
  .project-dialog audio, .project-dialog video { width: 100%; margin: 20px 0; }
  .dialog-actions { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; margin-top: 30px; }
  .dialog-actions a { color: #11231e; text-underline-offset: 5px; font-size: 14px; }
  .dialog-actions button { font: inherit; font-size: 14px; min-height: 44px; border: 1px solid #11231e; background: none; cursor: pointer; padding: 10px 14px; }
  @media (max-width: 680px) { .coaster-world { min-height: max(640px, calc(var(--filas-2) * 172px)); grid-template-columns: repeat(2, 1fr); padding: 10px; gap: 20px; } .coaster-wrapper { width: 144px; height: 144px; } .coaster-logo { font-size: 20px; } .coaster-logo.largo { font-size: 15px; } .coaster-logo.con-imagen img { width: 84px; max-height: 46px; } .coaster-face { padding: 15px; } .coaster-back { gap: 7px; } .back-title { font-size: 14px; } .header-ui { gap: 14px; } .coaster-heading { order: 3; flex-basis: 100%; } }
  @media (max-width: 360px) { .coaster-world { gap: 10px; padding: 0; } .coaster-wrapper { width: 132px; height: 132px; } }
  @media (prefers-reduced-motion: reduce) { .coaster-body, .coaster-wrapper { transition: none !important; } }
</style>
<script>import '../../scripts/coasters';</script>
