---
// src/pages/contacto.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Casita Manolo | El Ticket">
    
    <main class="printer-room">
        
        <!-- Botón Volver -->
        <a href="/" class="btn-volver">
            ← VOLVER A CASA
        </a>

        <!-- La ranura de la impresora por donde sale el ticket -->
        <div class="printer-slot"></div>

        <div class="ticket-wrapper">
            <article class="ticket">
                
                <!-- Encabezado del Local -->
                <header class="ticket-header">
                    <h1>CASITA MANOLO</h1>
                    <p>MUSIC HOUSE MADRID - NY</p>
                    <p>C/ INVENTADA, 42 - MADRID</p>
                    <p>NIF: B-12345678</p>
                </header>

                <!-- Metadatos (Generados dinámicamente) -->
                <div class="ticket-meta">
                    <div class="row"><span>MESA:</span> <span>04</span></div>
                    <div class="row"><span>FECHA:</span> <span id="current-date">--/--/----</span></div>
                    <div class="row"><span>HORA:</span> <span id="current-time">--:--</span></div>
                    <div class="row"><span>ATENDIÓ:</span> <span>MANOLO</span></div>
                </div>

                <div class="divider"></div>

                <!-- El "Manifiesto" disfrazado de comanda -->
                <div class="ticket-items">
                    <div class="row font-bold mb-2"><span>DESCRIPCIÓN</span> <span>IMP.</span></div>
                    <div class="row"><span>1x BRIEFING Y CAFÉ</span> <span>0.00</span></div>
                    <div class="row"><span>1x SESIÓN DE ESCUCHA</span> <span>0.00</span></div>
                    <div class="row"><span>1x TEMA A MEDIDA</span> <span>INV.</span></div>
                    <div class="row"><span>3x REVISIONES DEL CLIENTE</span> <span>INV.</span></div>
                    <div class="row"><span>1x MEZCLA Y MÁSTER</span> <span>INV.</span></div>
                </div>

                <div class="divider"></div>
                <div class="divider"></div>

                <!-- Formulario integrado en el ticket -->
                <div class="ticket-form-section">
                    <p class="form-instructions">>> A RELLENAR POR EL CLIENTE:</p>
                    
                    <form id="contact-form" class="ticket-form" action="https://formsubmit.co/infocasitamanolo@gmail.com" method="POST" data-astro-reload>
                        <input type="hidden" name="_subject" value="Nuevo ticket | Casita Manolo" />
                        <input type="hidden" name="_template" value="table" />
                        <input type="hidden" name="Fecha_UTC" id="submission-date" value="" />
                        <div class="form-row">
                            <label for="name">NOMBRE:</label>
                            <input type="text" id="name" name="nombre" required autocomplete="name" maxlength="150" />
                        </div>
                        
                        <div class="form-row">
                            <label for="email">E-MAIL:</label>
                            <input type="email" id="email" name="email" required autocomplete="email" maxlength="254" />
                        </div>
                        
                        <div class="form-row-col">
                            <label for="message">EL ENCARGO:</label>
                            <textarea id="message" name="encargo" rows="3" required maxlength="10000"></textarea>
                        </div>

                        <!-- El Botón es un Sello de Caucho Rojo -->
                        <div class="stamp-container">
                            <button type="submit" class="stamp-btn" id="submit-btn">
                                ENVIAR EL TICKET
                            </button>
                        </div>
                    </form>
                    <p class="contact-direct">También puedes escribirnos a <a href="mailto:infocasitamanolo@gmail.com">infocasitamanolo@gmail.com</a>.</p>
                </div>

                <div class="divider"></div>

                <!-- Pie del Ticket limpio -->
                <footer class="ticket-footer">
                    <p class="total">TOTAL: INVALUABLE</p>
                    <p class="thank-you">GRACIAS POR SU VISITA</p>
                    <p class="thank-you">WWW.CASITAMANOLO.COM</p>
                </footer>

            </article>
        </div>

        <!-- Only the provider can confirm a submission; do not simulate success. -->
        <div id="system-toast" class="system-toast" role="status" aria-live="polite"></div>

    </main>
</Layout>

<style>
    /* ========================================================
       1. VARIABLES Y ESTRUCTURA BASE
       ======================================================== */
    :root {
        --ink-dark: #11231E; 
        --paper-light: #F4F1EC; 
        --accent-red: #D74F42; 
        --thermal-blur: 0px 0px 1px rgba(17, 35, 30, 0.4);
        --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body, html {
        width: 100%;
        height: 100%;
        background-color: var(--ink-dark);
        font-family: 'Space Mono', monospace;
    }

    .printer-room {
        position: relative;
        width: 100%;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 60px 20px;
        overflow-y: auto;
        overflow-x: hidden;
    }

    /* Botón Volver Minimalista */
    .btn-volver {
        position: fixed;
        top: 40px;
        left: 40px;
        color: var(--paper-light);
        text-decoration: none;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        transition: color 0.3s, transform 0.3s;
        z-index: 100;
    }

    .btn-volver:hover {
        color: var(--accent-red);
        transform: translateX(-5px);
    }

    /* ========================================================
       2. EL TICKET TÉRMICO
       ======================================================== */
    .printer-slot {
        position: absolute;
        top: 0;
        width: 380px;
        height: 20px;
        background: #08110e;
        border-radius: 0 0 10px 10px;
        box-shadow: inset 0 10px 20px rgba(0,0,0,1);
        z-index: 50;
    }

    .ticket-wrapper {
        perspective: 1000px;
        margin-top: -60px;
    }

    .ticket {
        position: relative;
        width: 360px;
        background-color: var(--paper-light);
        color: var(--ink-dark);
        padding: 40px 30px;
        box-shadow: 0 30px 60px rgba(0,0,0,0.5);
        text-shadow: var(--thermal-blur);
        animation: printOut 1.5s var(--ease-out) forwards;
        transform-origin: top center;
    }

    @keyframes printOut {
        0% { transform: translateY(-100%) rotateX(-10deg); opacity: 0; }
        100% { transform: translateY(20px) rotateX(0deg); opacity: 1; }
    }

    /* BORDES ZIG-ZAG */
    .ticket::before,
    .ticket::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        height: 6px;
        background-size: 12px 100%;
    }

    .ticket::before {
        top: -6px;
        background-image: linear-gradient(135deg, var(--paper-light) 50%, transparent 50%),
                          linear-gradient(-135deg, var(--paper-light) 50%, transparent 50%);
        background-position: top left;
    }

    .ticket::after {
        bottom: -6px;
        background-image: linear-gradient(45deg, var(--paper-light) 50%, transparent 50%),
                          linear-gradient(-45deg, var(--paper-light) 50%, transparent 50%);
        background-position: bottom left;
    }

    /* ========================================================
       3. CONTENIDO DEL TICKET
       ======================================================== */
    .ticket-header {
        text-align: center;
        margin-bottom: 20px;
    }

    .ticket-header h1 {
        font-size: 1.8rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        line-height: 1.1;
        margin-bottom: 5px;
    }

    .ticket-header p {
        font-size: 0.75rem;
        line-height: 1.4;
    }

    .divider {
        border-top: 2px dashed var(--ink-dark);
        width: 100%;
        margin: 15px 0;
        opacity: 0.6;
    }

    .row {
        display: flex;
        justify-content: space-between;
        font-size: 0.8rem;
        line-height: 1.6;
    }

    .font-bold { font-weight: 700; }
    .mb-2 { margin-bottom: 8px; }

    /* ========================================================
       4. FORMULARIO INTEGRADO
       ======================================================== */
    .form-instructions {
        font-size: 0.75rem;
        font-weight: 700;
        margin-bottom: 15px;
        text-align: center;
    }

    .ticket-form {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .form-row {
        display: flex;
        align-items: flex-end;
        gap: 10px;
    }

    .form-row-col {
        display: flex;
        flex-direction: column;
        gap: 5px;
        margin-top: 5px;
    }

    .ticket-form label {
        font-size: 0.85rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .ticket-form input,
    .ticket-form textarea {
        flex-grow: 1;
        background: transparent;
        border: none;
        border-bottom: 2px dotted var(--ink-dark);
        color: var(--ink-dark);
        font-family: 'Space Mono', monospace;
        font-size: 0.85rem;
        padding: 2px 0;
        outline: none;
        resize: none;
        text-shadow: var(--thermal-blur);
        transition: border-color 0.3s;
    }

    .ticket-form textarea {
        background-image: linear-gradient(transparent, transparent 23px, var(--ink-dark) 24px);
        background-size: 100% 24px;
        line-height: 24px;
        border-bottom: none;
        padding-top: 0;
    }

    .ticket-form input:focus,
    .ticket-form textarea:focus {
        border-bottom-color: var(--accent-red);
    }

    /* EL SELLO (Botón Submit) */
    .stamp-container {
        display: flex;
        justify-content: center;
        margin-top: 30px;
        margin-bottom: 10px;
    }

    .stamp-btn {
        background: transparent;
        border: 3px solid var(--accent-red);
        color: var(--accent-red);
        font-family: 'Space Mono', monospace;
        font-size: 1.1rem;
        font-weight: 700;
        padding: 10px 20px;
        border-radius: 4px;
        cursor: pointer;
        transform: rotate(-4deg);
        opacity: 0.8;
        transition: transform 0.1s, opacity 0.3s;
        text-shadow: none; 
    }

    .stamp-btn:hover {
        opacity: 1;
        transform: scale(1.05) rotate(-6deg);
    }

    .stamp-btn:active {
        transform: scale(0.95) rotate(-2deg);
    }

    .stamp-btn:disabled { opacity: 0.5; cursor: wait; }
    .contact-direct { margin-top: 20px; font-size: 0.8rem; line-height: 1.7; text-align: center; overflow-wrap: anywhere; }
    .contact-direct a { color: inherit; text-underline-offset: 3px; }

    /* ========================================================
       5. PIE DEL TICKET
       ======================================================== */
    .ticket-footer {
        text-align: center;
        margin-top: 15px;
    }

    .total {
        font-size: 1.2rem;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .thank-you {
        font-size: 0.75rem;
        opacity: 0.7;
    }

    /* ========================================================
       6. SISTEMA DE NOTIFICACIÓN
       ======================================================== */
    .system-toast {
        position: fixed;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%) translateY(20px);
        background: #08110e;
        color: #4ade80; 
        padding: 10px 20px;
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        border: 1px solid #1a332a;
        opacity: 0;
        pointer-events: none;
        transition: all 0.4s var(--ease-out);
        z-index: 100;
        max-width: calc(100vw - 32px);
        text-align: center;
    }

    .system-toast.active {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
    }
</style>

<script>
    document.addEventListener('astro:page-load', () => {
        const dateElement = document.getElementById('current-date');
        const timeElement = document.getElementById('current-time');
        
        if (dateElement && timeElement) {
            const now = new Date();
            dateElement.textContent = now.toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric' });
            timeElement.textContent = now.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
        }

        const form = document.getElementById('contact-form') as HTMLFormElement;
        const toast = document.getElementById('system-toast');
        const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
        const submissionDate = document.getElementById('submission-date') as HTMLInputElement | null;

        if (form && toast && submitBtn) {
            const lifetime = new AbortController();
            const options = { signal: lifetime.signal };
            const resetSubmit = () => {
                submitBtn.disabled = false;
                submitBtn.textContent = 'ENVIAR EL TICKET';
                toast.classList.remove('active');
                toast.textContent = '';
            };
            resetSubmit();
            form.addEventListener('submit', (event) => {
                if (submitBtn.disabled) { event.preventDefault(); return; }
                if (submissionDate) submissionDate.value = new Date().toISOString();
                submitBtn.disabled = true;
                submitBtn.textContent = 'CONTINUANDO...';
                toast.textContent = 'Continúa en la página de envío para completar el ticket.';
                toast.classList.add('active');
                // Native POST works without JavaScript, keeps FormSubmit's CAPTCHA,
                // and lets the provider handle activation, errors and confirmation.
                // Keep the user's fields intact when returning to this page.
            }, options);
            window.addEventListener('pageshow', resetSubmit, options);
            document.addEventListener('astro:before-swap', () => lifetime.abort(), { once: true, signal: lifetime.signal });
        }
    });
</script>
