---
// src/pages/clientes.astro
import { ClientRouter } from 'astro:transitions';
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Casita Manolo | Clientes y Marcas</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <ClientRouter />
    
    <style>
        /* ========================================================
           1. RESET Y LA BARRA DEL BAR
           ======================================================== */
        :root {
            --paper: #F4F1EC;    
            --ink-red: #D74F42;  
            --wood-dark: #1f1209;
            --wood-light: #361f10;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body, html {
            width: 100%; height: 100%;
            background-color: var(--wood-dark);
            font-family: 'Space Mono', monospace;
            overflow: hidden; 
            user-select: none; 
        }

        .bar-counter {
            position: relative;
            width: 100vw;
            height: 100vh;
            background: 
                linear-gradient(to bottom, rgba(255,255,255,0.03) 0%, transparent 20%, transparent 80%, rgba(0,0,0,0.5) 100%),
                repeating-linear-gradient(90deg, rgba(0,0,0,0.1) 0px, rgba(0,0,0,0.1) 2px, transparent 2px, transparent 40px),
                var(--wood-light);
            box-shadow: inset 0 0 100px rgba(0,0,0,0.8);
        }

        .water-ring {
            position: absolute; top: 40%; left: 30%; width: 130px; height: 130px;
            border-radius: 50%; border: 4px solid rgba(255, 255, 255, 0.05); filter: blur(2px); pointer-events: none;
        }
        .water-ring::after {
            content: ""; position: absolute; top: -10px; left: 10px; width: 140px; height: 140px;
            border-radius: 50%; border: 2px solid rgba(0, 0, 0, 0.1); filter: blur(1px);
        }

        .header-ui {
            position: absolute; top: 40px; left: 40px; right: 40px;
            display: flex; justify-content: space-between; align-items: flex-start;
            pointer-events: none; z-index: 1000;
        }
        .btn-volver {
            pointer-events: auto; color: var(--paper); text-decoration: none;
            font-size: 0.75rem; font-weight: 700; letter-spacing: 0.3em; text-transform: uppercase;
            transition: color 0.3s, transform 0.3s; text-shadow: 0 2px 5px rgba(0,0,0,0.8);
        }
        .btn-volver:hover { color: var(--ink-red); transform: translateX(-5px); }
        .helper-text { color: rgba(244,241,236,0.3); font-size: 0.7rem; text-align: right; letter-spacing: 0.2em; text-transform: uppercase; }

        /* ========================================================
           2. LOS POSAVASOS (FÍSICAS Y ESTILOS)
           ======================================================== */
        .coaster-wrapper {
            position: absolute; top: 0; left: 0;
            width: 140px; height: 140px;
            will-change: transform; cursor: grab; touch-action: none;
        }
        .coaster-wrapper:active { cursor: grabbing; }

        /* Clase temporal para la animación de reparto inicial */
        .coaster-wrapper.is-dealing {
            transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); /* Efecto rebote suave */
        }

        .coaster-body {
            width: 100%; height: 100%; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            
            box-shadow: 
                -2px 4px 8px rgba(0,0,0,0.6), 
                inset -2px -5px 10px rgba(0,0,0,0.2), 
                inset 2px 5px 10px rgba(255,255,255,0.1);
            
            transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.2), box-shadow 0.2s ease;
        }

        .coaster-wrapper.is-dragging .coaster-body {
            transform: scale(1.08);
            box-shadow: 
                -10px 20px 25px rgba(0,0,0,0.6), 
                inset -2px -5px 10px rgba(0,0,0,0.2), 
                inset 2px 5px 10px rgba(255,255,255,0.2);
        }

        .coaster-logo {
            font-size: 1.4rem; font-weight: 700; font-family: Arial, sans-serif;
            text-align: center; line-height: 1; letter-spacing: -1px;
            mix-blend-mode: multiply; opacity: 0.8; pointer-events: none;
        }
        .coaster-logo span { display: block; font-size: 0.6rem; letter-spacing: 2px; margin-top: 5px; opacity: 0.6; font-family: 'Space Mono', monospace; }

        .c-kraft { background-color: #d2b48c; color: #3e2723; }
        .c-white { background-color: #f4f4f0; color: #111; }
        .c-black { background-color: #2c2c2c; color: #f4f4f0; mix-blend-mode: normal !important; }
        .c-black .coaster-logo { mix-blend-mode: normal; opacity: 0.9; }
    </style>
</head>
<body>

    <div class="bar-counter" id="physics-world">
        <div class="water-ring"></div>

        <div class="header-ui">
            <a href="/" class="btn-volver">← VOLVER AL LOCAL</a>
            <div class="helper-text">COGE Y LANZA<br>LOS POSAVASOS</div>
        </div>

        <div class="coaster-wrapper" data-mass="1">
            <div class="coaster-body c-white">
                <div class="coaster-logo" style="color: #E50914;">NETFLIX<span>SERIES</span></div>
            </div>
        </div>
        <div class="coaster-wrapper" data-mass="1.1">
            <div class="coaster-body c-black">
                <div class="coaster-logo" style="letter-spacing: 5px;">A24<span>FILMS</span></div>
            </div>
        </div>
        <div class="coaster-wrapper" data-mass="0.9">
            <div class="coaster-body c-white">
                <div class="coaster-logo">HBO<br>MAX<span>DOCUMENTAL</span></div>
            </div>
        </div>
        <div class="coaster-wrapper" data-mass="1">
            <div class="coaster-body c-kraft">
                <div class="coaster-logo">McCANN<span>SPOT TV</span></div>
            </div>
        </div>
        <div class="coaster-wrapper" data-mass="1.2">
            <div class="coaster-body c-white">
                <div class="coaster-logo" style="font-family: serif; font-size: 1.8rem;">VOGUE<span>FASHION FILM</span></div>
            </div>
        </div>
        <div class="coaster-wrapper" data-mass="0.95">
            <div class="coaster-body c-kraft">
                <div class="coaster-logo">BBDO<span>CAMPAÑA DIGITAL</span></div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('astro:page-load', () => {
            const world = document.getElementById('physics-world');
            const coasters = document.querySelectorAll('.coaster-wrapper');
            if (!world || coasters.length === 0) return;

            const friction = 0.94; 
            const bounce = 0.5;    
            let highestZ = 10;     
            const physicsData = new Map();

            const cWidth = 140; 
            const cHeight = 140;

            const limitX = window.innerWidth - cWidth;
            const limitY = window.innerHeight - cHeight;

            // Variables para el reparto de inicio (Grid invisible de huecos para vasos)
            // Si la pantalla es móvil (estrecha) hacemos 2 columnas, si no, 3.
            const cols = window.innerWidth > 800 ? 3 : 2; 
            const rows = Math.ceil(coasters.length / cols);
            const spacingX = limitX / cols;
            const spacingY = (limitY - 100) / rows; // -100 para no tapar el botón superior

            // Posición inicial: El "camarero" (Abajo, en el centro, fuera de pantalla)
            const dealerX = window.innerWidth / 2 - cWidth / 2;
            const dealerY = window.innerHeight + cHeight;

            coasters.forEach((coaster, index) => {
                
                // Calculamos en qué hueco (columna y fila) debe caer este posavasos
                const col = index % cols;
                const row = Math.floor(index / cols);

                // Posición objetivo en la cuadrícula + un poco de rotación y caos orgánico
                let targetX = (spacingX * col) + (spacingX / 2) + (Math.random() - 0.5) * 50;
                let targetY = 80 + (spacingY * row) + (spacingY / 2) + (Math.random() - 0.5) * 50;
                let targetRot = (Math.random() - 0.5) * 110;

                // Restringimos para que no queden pegados a los bordes
                targetX = Math.max(20, Math.min(limitX - 20, targetX));
                targetY = Math.max(80, Math.min(limitY - 20, targetY));

                const data = {
                    el: coaster as HTMLElement,
                    x: dealerX,   // Nace en el camarero
                    y: dealerY,
                    vx: 0, vy: 0,
                    rot: 0, vRot: 0,
                    isDragging: false,
                    dragOffsetX: 0, dragOffsetY: 0,
                    lastMouseX: 0, lastMouseY: 0
                };

                // Añadimos la clase CSS que hace la transición suave
                data.el.classList.add('is-dealing');
                data.el.style.zIndex = String(highestZ++);
                updateTransform(data);
                physicsData.set(coaster, data);

                // --- ANIMACIÓN DE REPARTO ESCALONADO ---
                setTimeout(() => {
                    // Les decimos que vayan a su objetivo
                    data.x = targetX;
                    data.y = targetY;
                    data.rot = targetRot;
                    updateTransform(data);
                    
                    // Cuando terminen el viaje (600ms), quitamos la clase de transición
                    // para que el motor de físicas de arrastre funcione sin lag
                    setTimeout(() => {
                        if (!data.isDragging) data.el.classList.remove('is-dealing');
                    }, 600); 

                }, 100 + (index * 120)); // El index * 120 crea el efecto "repartir cartas"

                // --- EVENTOS TÁCTILES / RATÓN ---
                coaster.addEventListener('pointerdown', (e) => {
                    const ev = e as PointerEvent;
                    data.isDragging = true;
                    data.el.classList.add('is-dragging');
                    data.el.classList.remove('is-dealing'); // Si lo cazas al vuelo, para la animación
                    data.el.style.zIndex = String(highestZ++); 
                    
                    data.vx = 0; data.vy = 0; data.vRot = 0;

                    const rect = data.el.getBoundingClientRect();
                    data.dragOffsetX = ev.clientX - rect.left;
                    data.dragOffsetY = ev.clientY - rect.top;
                    
                    data.lastMouseX = ev.clientX;
                    data.lastMouseY = ev.clientY;
                    
                    data.el.setPointerCapture(ev.pointerId);
                });

                coaster.addEventListener('pointermove', (e) => {
                    if (!data.isDragging) return;
                    const ev = e as PointerEvent;
                    
                    const deltaX = ev.clientX - data.lastMouseX;
                    const deltaY = ev.clientY - data.lastMouseY;
                    
                    data.x = ev.clientX - data.dragOffsetX;
                    data.y = ev.clientY - data.dragOffsetY;
                    
                    data.rot += (deltaX * 0.1); 
                    
                    data.vx = deltaX * 0.8; 
                    data.vy = deltaY * 0.8;
                    data.vRot = deltaX * 0.2; 

                    data.lastMouseX = ev.clientX;
                    data.lastMouseY = ev.clientY;
                    
                    updateTransform(data);
                });

                coaster.addEventListener('pointerup', (e) => {
                    if (!data.isDragging) return;
                    const ev = e as PointerEvent;
                    data.isDragging = false;
                    data.el.classList.remove('is-dragging');
                    data.el.releasePointerCapture(ev.pointerId);
                });
                
                coaster.addEventListener('pointercancel', () => {
                    data.isDragging = false;
                    data.el.classList.remove('is-dragging');
                });
            });

            function updateTransform(d) {
                d.el.style.transform = `translate3d(${d.x}px, ${d.y}px, 0) rotate(${d.rot}deg)`;
            }

            // --- BUCLE DEL MOTOR DE FÍSICAS (Render) ---
            let animationFrameId;

            function renderPhysics() {
                const maxX = window.innerWidth - cWidth;
                const maxY = window.innerHeight - cHeight;

                physicsData.forEach((data) => {
                    if (!data.isDragging && !data.el.classList.contains('is-dealing')) {
                        data.x += data.vx;
                        data.y += data.vy;
                        data.rot += data.vRot;

                        data.vx *= friction;
                        data.vy *= friction;
                        data.vRot *= friction;

                        if (Math.abs(data.vx) < 0.1) data.vx = 0;
                        if (Math.abs(data.vy) < 0.1) data.vy = 0;
                        if (Math.abs(data.vRot) < 0.1) data.vRot = 0;

                        if (data.x < 0) { data.x = 0; data.vx *= -bounce; data.vRot += data.vy * 0.1; }
                        if (data.x > maxX) { data.x = maxX; data.vx *= -bounce; data.vRot -= data.vy * 0.1; }
                        if (data.y < 0) { data.y = 0; data.vy *= -bounce; data.vRot -= data.vx * 0.1; }
                        if (data.y > maxY) { data.y = maxY; data.vy *= -bounce; data.vRot += data.vx * 0.1; }

                        if (data.vx !== 0 || data.vy !== 0 || data.vRot !== 0) {
                            updateTransform(data);
                        }
                    }
                });

                animationFrameId = requestAnimationFrame(renderPhysics);
            }

            renderPhysics();

            document.addEventListener('astro:before-swap', () => {
                cancelAnimationFrame(animationFrameId);
            }, { once: true });
            
            window.addEventListener('resize', () => {
                const maxX = window.innerWidth - cWidth;
                const maxY = window.innerHeight - cHeight;
                physicsData.forEach(d => {
                    if(d.x > maxX) d.x = maxX;
                    if(d.y > maxY) d.y = maxY;
                    if (!d.el.classList.contains('is-dealing')) updateTransform(d);
                });
            });
        });
    </script>
</body>
</html>