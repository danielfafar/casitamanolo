---
// Importamos el componente con su nuevo nombre oficial: ClientRouter
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Casita Manolo - Music House Madrid" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
		
		<!-- Magia de Astro: Enrutador de cliente para transiciones suaves -->
		<ClientRouter />
	</head>
	<body class="bg-[#F4F1EC] text-[#11231E] font-['Space_Mono'] antialiased selection:bg-[#D74F42] selection:text-white overflow-hidden transition-colors duration-700">
		<slot />
	</body>
</html>

<style is:global>
	html, body {
		width: 100%;
		height: 100%;
		margin: 0;
		padding: 0;
	}
	
	:root {
		--bg-color: #F4F1EC;
		--ink-color: #11231E;
		--accent-color: #D74F42;
		--ease-spring: cubic-bezier(0.175, 0.885, 0.32, 1.2);
		--ease-out: cubic-bezier(0.16, 1, 0.3, 1);
	}
</style>